#!/bin/bash
set -euo pipefail
. /.functions

#
# Init all the SSL-related stuff
#
init_ssl

#
# Load the environment file, if present
#
set_or_default ETL_ENV "${HOME}/.etl-env"
is_file_readable "${ETL_ENV}" && source "${ETL_ENV}"

usage()
{
	echo -e "usage: ${BASH_SOURCE:-${0}} [-p ... | --param ...] [-c ... | --custom ...] file.kjb"
	exit 1
}

cleanup_logs()
{
	local RC=${?}

	# Compress the newly-produced log, if it exists
	[ -n "${JOB_LOG}" ] && [ -f "${JOB_LOG}" ] && gzip -9 "${JOB_LOG}"

	# Retention within this job's own log tree: the run logs are named
	# ${JOB_ID}-<ts>.log, so the file name here is ${JOB_NAME}-<ts>.log.gz.
	# Newest last: keep the newest LOG_KEEP, remove the rest.
	find "${JOB_LOG_DIR}" -type f -name "${JOB_NAME}-*.log.gz" -print0 | \
		sort -z -r | \
		tail -z -n +$(( LOG_KEEP + 1 )) | \
		xargs -0 -r rm -fv
	return ${RC}
}

is_key_value_pair()
{
	local VAL="${1}"
	[[ "${VAL}" =~ ^[a-zA-Z0-9_]+=.*$ ]] || return 1
	return 0
}

cleanup()
{
	local RC=${?}
	cleanup_logs || true
	return ${RC}
}

[ ${#} -ge 1 ] || usage

ARGS="$(getopt -o "hp:c:" -l "help,param:,custom:" -n "${BASH_ARGV0:-${BASH_SOURCE:-${0}}}" -- "${@}" 2>/dev/null)" || usage
eval set -- "${ARGS}"

PARAM=()
CUSTOM=()
while true ; do
	case "${1}" in
		-c | --custom )
			VAL="${2}"
			is_key_value_pair "${VAL}" || fail "The custom value must be given as a KEY=VALUE pair: [${VAL}] is not valid syntax"
			CUSTOM+=(-custom:"${VAL}")
			shift 2
			;;
		-p | --param )
			VAL="${2}"
			is_key_value_pair "${VAL}" || fail "The parameter value must be given as a KEY=VALUE pair: [${VAL}] is not valid syntax"
			PARAM+=(-param:"${VAL}")
			shift 2
			;;
		-h | --help ) usage ;;

		-- ) shift ; break ;;
	esac
done

[ ${#} -eq 1 ] || usage

JOB="${1}"
[[ "${JOB,,}" == *.kjb ]] || fail "The job file must have the suffix '.kjb' (case-insensitive): [${JOB}]"

set_or_default BASE_DIR "/app"
set_or_default DATA_DIR "${BASE_DIR}/data"
set_or_default JOBS_DIR "${DATA_DIR}"

set_or_default PENTAHO_PDI_HOME "${BASE_DIR}/pentaho-pdi"

set_or_default CONF_KJB "config"

#
# Make sure the file exists and is in the expected location for all jobs. This
# is important because this is where the daemon will 
#
require_file_readable "${JOB}"
JOB_PATH="$(realpath --relative-base="${JOBS_DIR}" -- "${JOB}")"
[[ "${JOB_PATH}" == /* ]] && fail "The job file [${JOB}] must reside in a subdirectory of [${JOBS_DIR}]"
[[ "${JOB_PATH}" == */* ]] || fail "The job file [${JOB}] must reside in a subdirectory of [${JOBS_DIR}]"

# The job ID: it's ${JOB_PATH} without the suffix
JOB_ID="${JOB_PATH%.*}"
JOB_HOME="${JOBS_DIR}/$(dirname "${JOB_ID}")"
JOB_NAME="$(basename "${JOB_ID}")"

DEFAULT_LOG_KEEP=30
set_or_default LOG_KEEP
[[ "${LOG_KEEP}" =~ ^[1-9][0-9]*$ ]] || LOG_KEEP=${DEFAULT_LOG_KEEP}

# Capture and validate the timestamp
set_or_default RUN_KJB_TIMESTAMP "$(date -u "+%Y%m%d-%H%M%SZ")"
[[ "${RUN_KJB_TIMESTAMP}" =~ ^([2-9][0-9]{3})(0[1-9]|1[012])([012][0-9]|3[01])-([01][0-9]|2[0-3])([0-5][0-9])([0-5][0-9])Z$ ]] || fail "Invalid date [${RUN_KJB_TIMESTAMP}]"
YR="${BASH_REMATCH[1]}"
MO="${BASH_REMATCH[2]}"
DY="${BASH_REMATCH[3]}"
HR="${BASH_REMATCH[4]}"
MI="${BASH_REMATCH[5]}"
SE="${BASH_REMATCH[6]}"

# Really validate it ...
FULL_DATE="${YR}/${MO}/${DY} ${HR}:${MI}:${SE}"
OUT="$(date -d "${FULL_DATE}" 2>&1)" || fail "Invalid timestamp string [${RUN_KJB_TIMESTAMP}] (rc=${?}): ${OUT}"
export RUN_KJB_TIMESTAMP

# The run's logs live in ${JOB_HOME}/logs
export JOB_LOG_DIR="${JOB_HOME}/logs"
ensure_dir "${JOB_LOG_DIR}"

export DEV_NULL="/dev/null"

#
# No lock is set, so compute our own
#
# The lock mode the launcher enforces: 'default' is per-job (the job's
# own lock, so different jobs can run concurrently), 'single' is
# global (one lock for everything, so no two jobs run at once),
# 'none' disables locking. The server exports JOB_LOCK_MODE for API
# runs; standalone runs set it

set_or_default JOB_LOCK_MODE "default"
case "${JOB_LOCK_MODE,,}" in
	default ) JOB_LOCK="${JOB_HOME}/${JOB_NAME}.lock" ;;

	single ) JOB_LOCK="${JOBS_DIR}/global.lock" ;;

	none ) JOB_LOCK="${DEV_NULL}" ;;

	*) fail "JOB_LOCK_MODE must be 'default', 'single', or 'none' (got '${JOB_LOCK_MODE}')" ;;
esac

# The account the launcher runs as; recorded in the lock file as who
# started the job.
export JOB_CALLER="${SUDO_USER:-${USER:-"$(id -un)"}}"

__render_templates()
{
	# Find all the templates within the entire tree,
	# and render the final files.
	#
	# If the found item is a directory, then every file
	# within is processed, and the output goes to the
	# corresponding file within the sibling directory
	# of the same name, minus the "*.tpl" suffix.
	#
	# If the found item is a file, it will be rendered
	# to its corresponding file, minus the "*.tpl" suffix,
	# in the same directory.
	#
	# We're careful here to avoid double-rendering, so
	# first we find all files with the name "*.tpl", but
	# which are NOT within a folder with the name "*.tpl".
	# Then we process the folders with the name "*.tpl",
	# but which are NOT within a folder with the name
	# "*.tpl", and render the files within as described above

	# Encrypt the passwords, so we don't persist sensitive
	# values to disk unencrypted
	say "Encrypting passwords for Kettle"
	ENCRYPTED="$(encrypt-passwords kettle)" || fail "Failed to encrypt the passwords"
	source <(echo -n "${ENCRYPTED}") || fail "Failed to load the encrypted passwords"

	say "Rendering any necessary templated files"
	# Process the files
	while read SRC ; do
		# Remove the trailing ".tpl"
		TGT="${SRC%.*}"
		say "Rendering [${TGT}]..."
		render-template < "${JOB_HOME}/${SRC}" > "${JOB_HOME}/${TGT}"
	done < <(find "${JOB_HOME}" -type f -iname '*.tpl' -not -ipath '*/*.tpl/*' -printf "%P\n" | sort)

	say "Rendering any necessary templated directories"
	# Process the directories
	while read SRC_DIR ; do
		# Remove the trailing ".tpl"
		TGT_DIR="${SRC_DIR%.*}"
		say "Rendering files within [${TGT_DIR}]..."
		while read SRC ; do
			# Pre-pend the target path
			TGT="${TGT_DIR}/${SRC}"
			# Pre-pend the orignal template directory path
			SRC="${SRC_DIR}/${SRC}"
			say "\tRendering [${TGT}]..."
			mkdir -p "${JOB_HOME}/${TGT_DIR}"
			render-template < "${JOB_HOME}/${SRC}" > "${JOB_HOME}/${TGT}"
		done < <(find "${JOB_HOME}/${SRC_DIR}" -type f -printf "%P\n" | sort)
	done < <(find "${JOB_HOME}" -type d -iname '*.tpl' -not -ipath '*/*.tpl/*' -printf "%P\n" | sort)

	say "Template rendering completed"
	return 0
}

__main()
{
	# To temporarily disable template rendering, for debugging purposes
	set_as_boolean NOTEMPLATES

	################################################################################
	# Are there any templates to render?
	################################################################################
	CONF_KJB="${JOB_HOME}/${CONF_KJB}"

	if is_dir_readable "${CONF_KJB}" ; then
		say "Found the configuration directory at [${CONF_KJB}]"
		# The config directory should contain a kettle directory
		# with all the files (or templates) that would go in .kettle,
		# and a metastore directory with all the files (or templates)
		# that would go in .pentaho/metastore

		is_dir_readable "${CONF_KJB}/.kettle" && export KETTLE_HOME="${CONF_KJB}"
		is_dir_readable "${CONF_KJB}/metastore" && export JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:-} -DPENTAHO_METASTORE_FOLDER=${CONF_KJB}"

	else
		say "The configuration directory [${CONF_KJB}] was not found, will not set the KETTLE_HOME and PENTAHO_METASTORE_FOLDER variables"
	fi

	export KEYSTORE_PATH="${JAVA_KEYSTORE}"
	export KEYSTORE_PASSWORD="${JAVA_KEYSTORE_PASSWORD}"

	# Allow rendering to be disabled
	if "${NOTEMPLATES}" ; then
		say "Template rendering was disabled"
	else
		# This double-check makes it easier to use this script
		# in developers' environments
		require_exe render-template encrypt-passwords

		# Run as a subshell b/c it changes directory/whatnot
		( __render_templates )
	fi

	LOG_FLAG=()

	# Allow the log level to be set via environment variable
	[ -v LOG_LEVEL ] && [ -n "${LOG_LEVEL}" ] && LOG_FLAG=("-level:${LOG_LEVEL}")

	# If the log level isn't set by environment, then allow
	# for it to be set via a companion file?
	if [ ${#LOG_FLAG[@]} -eq 0 ] && [ -f "${JOB}.debug" ] ; then
		read LOG_LEVEL REST < <(sed -e 's;#.*$;;g' -e '/^\s*$/d' < "${JOB}.debug" | head -1) || true
		[ -n "${LOG_LEVEL}" ] && LOG_FLAG=("-level:${LOG_LEVEL}")
	fi

	running "Running the Kettle job from [${JOB}]"
	RC=0
	(
		__render_lock "${JOB_LOCK}" "${JOB_ID}" "${RUN_KJB_TIMESTAMP}" "${JOB_CALLER}" "${PARAM[@]}" "${CUSTOM[@]}"
		cd "${PENTAHO_PDI_HOME}/data-integration"
		execute ./kitchen.sh "${PARAM[@]}" "${CUSTOM[@]}" -file:"${JOB}" "${LOG_FLAG[@]}" < /dev/null
	) || RC=${?}
	say "Exit Status: [${RC}]"
	return ${RC}
}

# Record the lock's metadata before the exec, from the kitchen
# subshell: its BASHPID survives the exec and becomes kitchen's pid,
# which is what the server's /stop signals. The JSON is exactly what
# the status/409 responses return, plus the pid.
__render_lock()
{
	local LOCK="${1}"
	local JOB_ID="${2}"
	local RUN_ID="${3}"
	local CALLER="${4}"
	shift 4
	# No lock to record in no-lock mode: the target is /dev/null and
	# the server never reads it back.
	[ "${LOCK}" == "/dev/null" ] && return 0
	local JQ='
		def kv: map(capture("^(?<key>[^=]+)=(?<value>.*)$"; "s")) | from_entries;
		($ARGS.positional | kv) as $parameters
		| { job: $JOB_ID, run: $RUN_ID, pid: $PID, started: $STARTED, caller: $CALLER, parameters: $parameters }
	'
	local CMD=()
	CMD=(
		jq -n
			"${JQ}"
			--arg JOB_ID "${JOB_ID}"
			--arg RUN_ID "${RUN_ID}"
			--argjson PID "${BASHPID}"
			--arg STARTED "$(date -u -Ins)"
			--arg CALLER "${CALLER}"

			#
			# Add parameters and customs. JQ will resolve any
			# conflicts in favor of CUSTOM b/c they're coming
			# later in the command line.
			#
			--args "${@#*:}"
	)

	"${CMD[@]}" > "${LOCK}"
}

__flock()
{
	local FD="${1}"
	local LOCK="${2}"
	local MSG="${3:-The job [${JOB_ID}] is locked}"

	[ "${LOCK}" == "${DEV_NULL}" ] && return 0
	flock -xn "${FD}" || fail "${MSG}"
}

#
# This helps us achieve a clean redirection every time, regardless
# if locking is active or not:
#
#   - If locking is active, the __flock call will run the `flock -xn`
#     call with the correct file descriptor for the lock file
#
#   - If locking is not active, the __flock call will simply return
#     immediately with no invocation of `flock`, and the redirection
#     for the file descriptor will simply go to `/dev/null`
#
export DEV_NULL="/dev/null"
# Note: LOCK_FD is not pre-set on purpose: the `{LOCK_FD}<file`
# redirection below lets bash allocate a free descriptor and assign
# it to the variable.
[ "${JOB_LOCK}" == "-" ] && JOB_LOCK="${DEV_NULL}"
# Create the lock file we will hold, if it is a real file (append-open
# never truncates; the exclusive flock below is what protects its
# content). In single mode JOB_LOCK is the global lock.
[ "${JOB_LOCK}" != "${DEV_NULL}" ] && : >> "${JOB_LOCK}"

# The run is identified by ${JOB_ID}-${RUN_KJB_TIMESTAMP}; its log
# file is named after the run ID's basename part,
# ${JOB_NAME}-${RUN_KJB_TIMESTAMP}, under the job's log dir.
export JOB_LOG="${JOB_LOG_DIR}/${JOB_NAME}-${RUN_KJB_TIMESTAMP}.log"

# Start the logging!
redirect_logs "${JOB_LOG}"
trap cleanup EXIT

# One lock per run: the run locks exactly one file — the job's own
# lock in per-job mode, the global lock in single mode (the running
# copy's __render_lock writes its metadata into it; that is what the
# server's status/409/stop read back), or /dev/null in no-lock mode
# (the __flock call returns immediately, no flock at all).
LOCK_MSG="An instance of [${JOB_ID}] is already running"
[ "${JOB_LOCK_MODE}" == "single" ] && LOCK_MSG="A job is already running (single mode): the global lock [${JOB_LOCK}] is held"
{
	__flock "${LOCK_FD}" "${LOCK_MSG}"
	__main "${@}" || exit ${?}
	exit 0
} {LOCK_FD}<"${JOB_LOCK}"
