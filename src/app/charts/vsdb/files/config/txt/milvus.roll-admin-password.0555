#!/bin/bash

set -euo pipefail
. /.functions

#
# Roll the Milvus root password without knowing its previous value.
#
# Milvus only accepts a password change from an authenticated session, but its
# coordinator (re)creates root from common.security.defaultRootPassword when it
# starts up and root's credential record is missing. So, when the configured
# password changes, we delete that record before Milvus boots, and let Milvus
# recreate it:
#
#	${ETCD_ROOT_PATH}/${ETCD_META_SUB_PATH}/root-coord/credential/users/root
#
# To know whether the password changed, we keep a marker record (outside of
# Milvus' key space) with a SHA-256 hash of the password that's in effect:
#
#	1. Read the marker's hash (an empty string if the marker doesn't exist)
#
#	2. If it differs from the configured password's hash, then it's our job to
#	   roll it: in a single etcd transaction, conditioned on the marker not
#	   having changed since we read it, store the new hash in the marker and
#	   delete root's credential record. Then carry on with the boot.
#
#	   If the transaction fails, another pod beat us to it, so start over: if
#	   it stored the same hash we wanted, we'll take the next path.
#
#	3. If it matches, then another pod already rolled it (or it was rolled on
#	   an earlier boot), so wait until root's credential record has been
#	   recreated after the marker was last updated, then carry on with the boot.
#
# Known limitation with more than one Milvus pod: the coordinator only
# recreates root when it becomes active, so if the pod that rolls the password
# comes up as a standby, root stays missing (and the other pods keep waiting)
# until the active coordinator's pod is replaced.
#

set_or_default ETCD_ROOT_PATH "by-dev"
set_or_default ETCD_META_SUB_PATH "meta"

# Keep the marker outside of Milvus' key space
set_or_default ROOT_HASH_MARKER_KEY "arkcase/milvus/root-password-hash"

# How long to wait (seconds) for root's credential record to be recreated, and
# how often (seconds) to check for it
set_or_default ROOT_WAIT_TIMEOUT 900
[[ "${ROOT_WAIT_TIMEOUT}" =~ ^[1-9][0-9]*$ ]] || ROOT_WAIT_TIMEOUT=900
set_or_default ROOT_WAIT_POLL 2
[[ "${ROOT_WAIT_POLL}" =~ ^[1-9][0-9]*$ ]] || ROOT_WAIT_POLL=2

# How many times to start over if another pod beats us to the marker
set_or_default ROLL_MAX_ATTEMPTS 10
[[ "${ROLL_MAX_ATTEMPTS}" =~ ^[1-9][0-9]*$ ]] || ROLL_MAX_ATTEMPTS=10

set_or_default ETCDCTL_DIAL_TIMEOUT "10s"
set_or_default ETCDCTL_COMMAND_TIMEOUT "30s"
export ETCDCTL_DIAL_TIMEOUT ETCDCTL_COMMAND_TIMEOUT

# Quote a string the way etcdctl's txn parser expects (Go-style double quotes)
txn_quote()
{
	jq -n --arg V "${1}" '$V'
}

#
# usage: etcd_get KEY
#
# Outputs { "create": CREATE_REVISION, "mod": MOD_REVISION, "value": "VALUE" }
# for KEY, or nothing if it doesn't exist
#
etcd_get()
{
	local KEY="${1}"
	local OUT=""
	OUT="$(etcdctl get "${KEY}" -w json 2>&1)" || { err "Failed to read the key [${KEY}] from etcd (rc=${?}):\n${OUT}" ; return 1 ; }
	jq -c '(.kvs // [])[0] // empty | { "create": (.create_revision // 0), "mod": (.mod_revision // 0), "value": ((.value // "") | @base64d) }' <<< "${OUT}"
}

wait_for_root()
{
	local MARKER_MOD="${1}"
	local ROOT=""
	local CREATE=""
	local START="$(date +%s)"

	while true ; do
		ROOT="$(etcd_get "${ROOT_KEY}")" || return 1
		if [ -n "${ROOT}" ] ; then
			CREATE="$(jq -r '.create' <<< "${ROOT}")" || return 1
			if [ "${CREATE}" -gt "${MARKER_MOD}" ] ; then
				ok "The root credential has been recreated since the password was rolled"
				return 0
			fi
		fi

		if [ $(( $(date +%s) - START )) -ge "${ROOT_WAIT_TIMEOUT}" ] ; then
			err "Timed out after ${ROOT_WAIT_TIMEOUT} seconds waiting for the root credential to be recreated"
			return 1
		fi

		sleeping "Waiting for the root credential to be recreated..."
		sleep "${ROOT_WAIT_POLL}"
	done
}

roll_password()
{
	local ATTEMPT=0
	local MARKER=""
	local OLD_HASH=""
	local MARKER_MOD=""
	local TXN=""
	local OUT=""

	for (( ATTEMPT = 1 ; ATTEMPT <= ROLL_MAX_ATTEMPTS ; ATTEMPT++ )) ; do
		MARKER="$(etcd_get "${ROOT_HASH_MARKER_KEY}")" || return 1
		OLD_HASH=""
		MARKER_MOD="0"
		if [ -n "${MARKER}" ] ; then
			OLD_HASH="$(jq -r '.value' <<< "${MARKER}")" || return 1
			MARKER_MOD="$(jq -r '.mod' <<< "${MARKER}")" || return 1
		fi

		if [ "${OLD_HASH}" == "${NEW_HASH}" ] ; then
			eyes "The root password is already rolled, making sure the root credential is in place"
			wait_for_root "${MARKER_MOD}"
			return ${?}
		fi

		# A missing key has a mod_revision of 0, so this also covers the marker's
		# creation. The format is: the comparisons, a blank line, the success
		# operations, a blank line, and the failure operations (none), ending
		# with a blank line.
		TXN="$(
			printf 'mod(%s) = "%s"\n' "$(txn_quote "${ROOT_HASH_MARKER_KEY}")" "${MARKER_MOD}"
			echo
			printf 'put %s %s\n' "$(txn_quote "${ROOT_HASH_MARKER_KEY}")" "$(txn_quote "${NEW_HASH}")"
			printf 'del %s\n' "$(txn_quote "${ROOT_KEY}")"
		)"

		# The command substitution strips the trailing blank lines, so add them here
		OUT="$(printf '%s\n\n\n' "${TXN}" | etcdctl txn -w json 2>&1)" || { err "Failed to apply the transaction to roll the root password (rc=${?}):\n${OUT}" ; return 1 ; }

		if jq -e '.succeeded // false' <<< "${OUT}" &>/dev/null ; then
			ok "Rolled the root password: Milvus will recreate the root credential when it starts"
			return 0
		fi

		warn "Another pod updated the root password marker first, starting over (attempt ${ATTEMPT} of ${ROLL_MAX_ATTEMPTS})"
	done

	err "Failed to roll the root password after ${ROLL_MAX_ATTEMPTS} attempts"
	return 1
}

[ -v ADMIN_USERNAME ] || fail "The ADMIN_USERNAME variable isn't set"
[ -v ADMIN_PASSWORD ] || fail "The ADMIN_PASSWORD variable isn't set"

# Milvus only recreates root, so this only works for root
[ "${ADMIN_USERNAME}" == "root" ] || fail "The admin user must be [root], not [${ADMIN_USERNAME}]"

# Milvus' (and bcrypt's) limits for passwords
PASSWORD_BYTES="$(printf '%s' "${ADMIN_PASSWORD}" | wc -c)"
[ "${PASSWORD_BYTES}" -ge 6 ] && [ "${PASSWORD_BYTES}" -le 72 ] || fail "The admin password must be between 6 and 72 bytes long (is ${PASSWORD_BYTES})"

for V in ETCD_ROOT_PATH ETCD_META_SUB_PATH ROOT_HASH_MARKER_KEY ; do
	[ -n "${!V}" ] || fail "The ${V} variable may not be empty"
done

ROOT_KEY="${ETCD_ROOT_PATH}/${ETCD_META_SUB_PATH}/root-coord/credential/users/root"
[ "${ROOT_HASH_MARKER_KEY}" != "${ROOT_KEY}" ] || fail "The ROOT_HASH_MARKER_KEY may not be the root credential's key"

require_exe etcdctl jq sha256sum
init_ssl || fail "Failed to initialize the SSL layer"

[ -v ETCD_ENDPOINTS ] && [ -n "${ETCD_ENDPOINTS}" ] || fail "The ETCD_ENDPOINTS variable isn't set"
export ETCDCTL_ENDPOINTS="${ETCD_ENDPOINTS}"
export ETCDCTL_CACERT="${SSL_CA_ROOT}"
export ETCDCTL_CERT="${SSL_CERTIFICATE}"
export ETCDCTL_KEY="${SSL_PRIVATE_KEY}"

# Piped, so the password never shows up in any process' arguments
NEW_HASH="$(printf '%s' "${ADMIN_PASSWORD}" | sha256sum | cut -d ' ' -f 1)"
[[ "${NEW_HASH}" =~ ^[0-9a-f]{64}$ ]] || fail "Failed to compute the root password's hash"

roll_password || fail "Failed to roll the root password"
exit 0
