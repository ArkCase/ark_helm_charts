#!/bin/bash

set -euo pipefail
. /.functions

#
# Ping Tomcat's internal communications port, which is only opened once
# Tomcat successfully completes its bootup sequence
#
MSG=""
[ ${#} -lt 1 ] || MSG="${@}"
[ -n "${MSG}" ] || MSG="PING"
timeout --signal=KILL 5 bash -c 'echo -n "PROBE: ${1}" > "/dev/tcp/localhost/8005"' -- "${MSG}" &>/dev/null || fail "Tomcat is not started (${?})"

#
# All is well... ready to go!
#
ok "Tomcat is live!"
