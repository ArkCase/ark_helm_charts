<config
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="urn:org:jgroups"
	xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups.xsd">

	<TCP_NIO2
		bind_addr="NON_LOOPBACK"
		bind_port="7800"
		port_range="1"
		recv_buf_size="5M"
		send_buf_size="1M"
		sock_conn_timeout="2000"
	/>

	<org.jgroups.protocols.kubernetes.KUBE_PING
		port_range="1"
		namespace="${DNS_NAMESPACE}"
		labels="jgroups.armedia.com/eclipse-cache=true"
	/>

	<MERGE3
		min_interval="5000"
		max_interval="15000"
	/>

	<FD_SOCK2/>

	<FD_ALL3/>

	<VERIFY_SUSPECT2
		timeout="1500"
	/>

	<pbcast.NAKACK2
		xmit_interval="500"
		xmit_table_num_rows="100"
		xmit_table_msgs_per_row="2000"
		xmit_table_max_compaction_time="30000"
		use_mcast_xmit="false"
		discard_delivered_msgs="true"
	/>

	<UNICAST3
		xmit_interval="500"
		xmit_table_num_rows="100"
		xmit_table_msgs_per_row="1000"
		xmit_table_max_compaction_time="30000"
	/>

	<pbcast.STABLE
		desired_avg_gossip="50000"
		max_bytes="8m"
	/>

	<pbcast.GMS
		print_local_addr="true"
		join_timeout="5000"
	/>

	<UFC
		max_credits="4M"
		min_threshold="0.4"
	/>

	<FRAG3
		frag_size="60K"
	/>

</config>