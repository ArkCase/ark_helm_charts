#!/bin/bash
SCRIPT="$(/usr/bin/readlink -f "${BASH_ARGV0:-${BASH_SOURCE:-${0}}}")"
SCRIPT="$(/usr/bin/basename "${SCRIPT}")"

set -euo pipefail

#
# Copies the data for one PVC, depending on ${TASK_MODE} (and ${S3_DIRECTION}):
#
#   clone:          from ${SOURCE_DIR} into the new PVC at ${TARGET_DIR}, via rsync
#   s3 (upload):    from ${SOURCE_DIR} into s3://${S3_BUCKET}/${S3_PREFIX}.tar.gz
#   s3 (download):  from s3://${S3_BUCKET}/${S3_PREFIX}.tar.gz into ${TARGET_DIR}
#
# If ${CLEAN_TARGET} is true, the contents of ${TARGET_DIR} (except lost+found)
# are removed before the first attempt.
#
# The work is attempted up to ${MAX_ATTEMPTS} times. Then, whatever the outcome,
# the exit status is written into ${RESULT_MARKER} (which makes the pod Ready),
# and the script waits forever: restart the pod to repeat the work.
#

STARTED_MARKER="/.pod.started"
RESULT_MARKER="/.pod.result"

DEFAULT_MAX_ATTEMPTS="5"

# Returned by an attempt that failed in a way that retrying won't fix
NO_RETRY_RC="100"

timestamp()
{
	/usr/bin/date -Ins -u
}

say()
{
	echo -e "$(timestamp): ${@}"
}

ok()
{
	say "✅ ${@}"
}

warn()
{
	say "⚠️ ${@}"
}

err()
{
	say "❌ ${@}"
}

fail()
{
	err "${@}"
	exit "${EXIT_CODE:-1}"
}

to_boolean()
{
	case "${1,,}" in
		true | t | yes | y ) echo -n "true" ;;
		* ) echo -n "false" ;;
	esac
}

is_valid_name()
{
	local NAME="${1}"
	[[ "${NAME}" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] || return 1
	return 0
}

ensure_dir()
{
	local DIR="${1}"
	[ -e "${DIR}" ] || fail "The directory [${DIR}] does not exist"
	[ -d "${DIR}" ] || fail "The path [${DIR}] is not a directory"
	[ -r "${DIR}" ] || fail "The directory [${DIR}] is not readable"
	[ -x "${DIR}" ] || fail "The directory [${DIR}] is not executable"
	return 0
}

ensure_target_dir()
{
	ensure_dir "${TARGET_DIR}"
	[ -w "${TARGET_DIR}" ] || fail "The directory [${TARGET_DIR}] is not writable"
	[ "$(/usr/bin/readlink -f "${TARGET_DIR}")" != "/" ] || fail "The target directory may not be the root directory"
	return 0
}

clean_target()
{
	say "🧹 Removing the existing contents of [${TARGET_DIR}] (except lost+found)..."
	/usr/bin/find "${TARGET_DIR}" -mindepth 1 -maxdepth 1 ! -name "lost+found" -exec /usr/bin/rm -rf -- "{}" + || return 1
	ok "The target directory is clean"
	return 0
}

#
# List the contents of the current directory such that two copies of
# the same data produce the same output: type, mode, ownership, size
# (except for directories, whose size depends on the filesystem), and
# path, sorted by path
#
list_contents()
{
	/usr/bin/find . \
		-path "./lost+found" -prune -o \
		\( -type d -printf "%p\t%y %m %U:%G\n" \) -o \
		-printf "%p\t%y %m %U:%G %s\n" | LC_ALL="C" /usr/bin/sort
}

verify_clone()
{
	say "👀 Verifying the copy's correctness"
	local OLD_LIST="${WORK_DIR}/source.list"
	local NEW_LIST="${WORK_DIR}/target.list"
	( cd "${SOURCE_DIR}" && list_contents ) > "${OLD_LIST}" || { err "Failed to list the source's contents" ; return 1 ; }
	( cd "${TARGET_DIR}" && list_contents ) > "${NEW_LIST}" || { err "Failed to list the target's contents" ; return 1 ; }

	if ! /usr/bin/cmp -s "${OLD_LIST}" "${NEW_LIST}" ; then
		err "The source and target contents differ (showing up to 100 lines of differences):"
		/usr/bin/diff "${OLD_LIST}" "${NEW_LIST}" | /usr/bin/head -n 100 || true
		return 1
	fi

	ok "Copy verified ($(/usr/bin/wc -l < "${OLD_LIST}") entries)"
	return 0
}

run_clone()
{
	local CMD=(
		"${RSYNC}"
		-aHS
		--numeric-ids
		--delete-delay
		--exclude="/lost+found"
		--human-readable
		--stats
		"${SOURCE_DIR}/"
		"${TARGET_DIR}/"
	)
	say "👀 Will use the command: ${CMD[@]@Q}"

	local RC="0"
	"${CMD[@]}" || RC="${?}"
	case "${RC}" in
		0 ) ;;
		30 ) warn "Timeout detected" ; return "${RC}" ;;
		* ) err "Failed to copy the data (rc = ${RC})" ; return "${RC}" ;;
	esac

	verify_clone || return "${?}"
	return 0
}

#
# Compare the archive in S3 against the given directory, with tar --diff:
# every member's type, permissions, ownership, size, modification time and
# contents must match (files that aren't in the archive are ignored)
#
verify_s3()
{
	local DIR="${1}"
	say "👀 Verifying [${S3_URL}] against [${DIR}]..."
	local CMD=(
		"${TAR}"
		--diff
		--gzip
		--file=-
		--directory="${DIR}"
		--numeric-owner
		"${TAR_FLAGS[@]}"
	)
	local DIFF="${WORK_DIR}/tar.diff"
	local RC="0"
	"${AWS}" "${AWS_FLAGS[@]}" s3 cp --only-show-errors "${S3_URL}" - | "${CMD[@]}" > "${DIFF}" 2>&1 || RC="${?}"
	if [ "${RC}" -ne 0 ] ; then
		err "The archive and [${DIR}] differ, or the comparison failed (rc = ${RC}) - showing up to 100 lines of output:"
		/usr/bin/head -n 100 "${DIFF}" || true
		return 1
	fi

	ok "Archive verified"
	return 0
}

run_s3_upload()
{
	# The AWS CLI needs an idea of the stream's size to pick a multipart chunk
	# size that can handle it (the default only reaches ~78GiB)
	local SIZE=""
	SIZE="$(/usr/bin/du -sb "${SOURCE_DIR}" | /usr/bin/awk '{ print $1 }')" || { err "Failed to compute the source's size" ; return 1 ; }
	say "👀 The source data is ${SIZE} bytes (uncompressed)"

	local TAR_CMD=(
		"${TAR}"
		--create
		--gzip
		--file=-
		--directory="${SOURCE_DIR}"
		--numeric-owner
		--sparse
		"${TAR_FLAGS[@]}"
		--exclude="./lost+found"
		.
	)
	local AWS_CMD=(
		"${AWS}" "${AWS_FLAGS[@]}" s3 cp
		--only-show-errors
		--expected-size "${SIZE}"
		-
		"${S3_URL}"
	)
	say "👀 Will use the command: ${TAR_CMD[@]@Q} | ${AWS_CMD[@]@Q}"

	local RC="0"
	"${TAR_CMD[@]}" | "${AWS_CMD[@]}" || RC="${?}"
	if [ "${RC}" -ne 0 ] ; then
		err "Failed to upload the data (rc = ${RC})"
		return "${RC}"
	fi
	ok "Upload complete"

	if "${S3_VERIFY}" ; then
		verify_s3 "${SOURCE_DIR}" || return "${?}"
	fi
	return 0
}

run_s3_download()
{
	# Make sure there's something to download
	local OUT=""
	if ! OUT="$("${AWS}" "${AWS_FLAGS[@]}" s3api head-object --bucket "${S3_BUCKET}" --key "${S3_KEY}" --query "ContentLength" --output text 2>&1)" ; then
		if [[ "${OUT}" == *"Not Found"* ]] || [[ "${OUT}" == *"(404)"* ]] ; then
			err "The archive [${S3_URL}] does not exist"
			return "${NO_RETRY_RC}"
		fi
		err "Failed to look up the archive [${S3_URL}]: ${OUT}"
		return 1
	fi
	say "👀 The archive is ${OUT} bytes (compressed)"

	local AWS_CMD=(
		"${AWS}" "${AWS_FLAGS[@]}" s3 cp
		--only-show-errors
		"${S3_URL}"
		-
	)
	local TAR_CMD=(
		"${TAR}"
		--extract
		--gzip
		--file=-
		--directory="${TARGET_DIR}"
		--numeric-owner
		--same-owner
		--same-permissions
		"${TAR_FLAGS[@]}"
	)
	say "👀 Will use the command: ${AWS_CMD[@]@Q} | ${TAR_CMD[@]@Q}"

	local RC="0"
	"${AWS_CMD[@]}" | "${TAR_CMD[@]}" || RC="${?}"
	if [ "${RC}" -ne 0 ] ; then
		err "Failed to download and extract the data (rc = ${RC})"
		return "${RC}"
	fi
	ok "Download complete"

	if "${S3_VERIFY}" ; then
		verify_s3 "${TARGET_DIR}" || return "${?}"
	fi
	return 0
}

run_task()
{
	local ATTEMPT=""
	local RC=""
	for (( ATTEMPT = 1 ; ATTEMPT <= MAX_ATTEMPTS ; ATTEMPT++ )) ; do
		say "👉 Starting attempt # ${ATTEMPT} of ${MAX_ATTEMPTS}..."
		RC="0"
		"run_${TASK}" || RC="${?}"
		if [ "${RC}" -eq 0 ] ; then
			ok "Work complete!"
			return 0
		fi
		if [ "${RC}" -eq "${NO_RETRY_RC}" ] ; then
			err "Attempt # ${ATTEMPT} failed, and retrying won't help"
			return 1
		fi
		warn "Attempt # ${ATTEMPT} failed"
	done
	err "The work could not be completed after ${MAX_ATTEMPTS} attempts"
	return 1
}

[ -v LOGS_DIR ] || LOGS_DIR=""
[ -n "${LOGS_DIR}" ] || LOGS_DIR="/logs"

[ -v MAX_ATTEMPTS ] || MAX_ATTEMPTS=""
[[ "${MAX_ATTEMPTS}" =~ ^[1-9][0-9]*$ ]] || MAX_ATTEMPTS="${DEFAULT_MAX_ATTEMPTS}"

LOG_BASE="${SCRIPT}"
STAMP="$(/usr/bin/date -u "+%Y%m%d-%H%M%SZ")"
MAIN_LOG="${LOGS_DIR}/${LOG_BASE}.${STAMP}.log"

say "👀 Logging to [${MAIN_LOG}]"
exec > >(/usr/bin/tee "${MAIN_LOG}")
exec 2>&1

:> "${STARTED_MARKER}"

#
# Run the work in a subshell, so any failure in it (including
# the validations) still produces a result
#
(
	set -euo pipefail

	[ -v TASK_MODE ] || TASK_MODE=""
	TASK_MODE="${TASK_MODE,,}"
	[ -v S3_DIRECTION ] || S3_DIRECTION=""
	S3_DIRECTION="${S3_DIRECTION,,}"
	case "${TASK_MODE}" in
		clone ) TASK="clone" ;;
		s3 )
			case "${S3_DIRECTION}" in
				"" | upload ) TASK="s3_upload" ;;
				download ) TASK="s3_download" ;;
				* ) fail "Unsupported S3_DIRECTION value [${S3_DIRECTION}]" ;;
			esac
			;;
		* ) fail "Unsupported TASK_MODE value [${TASK_MODE}]" ;;
	esac

	[ -v POD_NAME ] || POD_NAME="${HOSTNAME}"

	[ -v SOURCE_DIR ] || SOURCE_DIR=""
	[ -n "${SOURCE_DIR}" ] || SOURCE_DIR="/source"
	[ -v SOURCE_PVC ] || SOURCE_PVC=""
	[ -v TARGET_DIR ] || TARGET_DIR=""
	[ -n "${TARGET_DIR}" ] || TARGET_DIR="/target"
	[ -v TARGET_PVC ] || TARGET_PVC=""
	[ -v CLEAN_TARGET ] || CLEAN_TARGET=""
	CLEAN_TARGET="$(to_boolean "${CLEAN_TARGET}")"

	# The PVC this pod was deployed for: the source, except when downloading into it
	if [ "${TASK}" == "s3_download" ] ; then
		PVC_VAR="TARGET_PVC"
	else
		PVC_VAR="SOURCE_PVC"
	fi
	PVC="${!PVC_VAR}"
	[ -n "${PVC}" ] || fail "The ${PVC_VAR} variable is not set"
	is_valid_name "${PVC}" || fail "The ${PVC_VAR} value [${PVC}] is not a valid PVC name"

	# When we're one of many pods, make sure we're working on our own PVC
	if [ -v POD_INDEX ] ; then
		[[ "${POD_INDEX}" =~ ^(0|[1-9][0-9]*)$ ]] || fail "The POD_INDEX value [${POD_INDEX}] is not valid (the apps.kubernetes.io/pod-index label requires Kubernetes 1.28 or later)"
		[ "${POD_NAME##*-}" == "${POD_INDEX}" ] || fail "The POD_INDEX value [${POD_INDEX}] doesn't match the pod name [${POD_NAME}]"
		[ "${PVC##*-}" == "${POD_INDEX}" ] || fail "The ${PVC_VAR} value [${PVC}] doesn't match the pod index [${POD_INDEX}]"
	fi

	WORK_DIR="$(/usr/bin/mktemp -d)" || fail "Failed to create a work directory"

	case "${TASK}" in
		clone )
			ensure_dir "${SOURCE_DIR}"
			ensure_target_dir
			[ -n "${TARGET_PVC}" ] || TARGET_PVC="(unknown)"

			RSYNC="$(type -P rsync)" || fail "Failed to find rsync in the path"

			say "👉 Copying PVC ${SOURCE_PVC} into PVC ${TARGET_PVC}"
			;;

		s3_* )
			[ -v S3_BUCKET ] || S3_BUCKET=""
			[ -n "${S3_BUCKET}" ] || fail "The S3_BUCKET variable is not set"
			[ -v S3_PREFIX ] || S3_PREFIX=""
			[ -n "${S3_PREFIX}" ] || fail "The S3_PREFIX variable is not set"
			[ -v S3_REGION ] || S3_REGION=""
			[ -v S3_ENDPOINT ] || S3_ENDPOINT=""
			[ -v S3_VERIFY ] || S3_VERIFY="true"
			S3_VERIFY="$(to_boolean "${S3_VERIFY}")"

			AWS="$(type -P aws)" || fail "Failed to find aws in the path"
			TAR="$(type -P tar)" || fail "Failed to find tar in the path"
			type -P gzip &>/dev/null || fail "Failed to find gzip in the path"

			AWS_FLAGS=()
			[ -n "${S3_REGION}" ] && AWS_FLAGS+=(--region "${S3_REGION}")
			[ -n "${S3_ENDPOINT}" ] && AWS_FLAGS+=(--endpoint-url "${S3_ENDPOINT}")

			# Preserve ACLs and extended attributes, if this tar can
			TAR_FLAGS=()
			TAR_HELP="$("${TAR}" --help 2>&1)" || true
			for FLAG in --acls --xattrs ; do
				[[ "${TAR_HELP}" == *"${FLAG}"* ]] && TAR_FLAGS+=("${FLAG}")
			done

			S3_KEY="${S3_PREFIX}.tar.gz"
			S3_URL="s3://${S3_BUCKET}/${S3_KEY}"

			if [ "${TASK}" == "s3_upload" ] ; then
				ensure_dir "${SOURCE_DIR}"
				say "👉 Uploading PVC ${SOURCE_PVC} into [${S3_URL}]"
			else
				ensure_target_dir
				say "👉 Downloading [${S3_URL}] into PVC ${TARGET_PVC}"
			fi
			;;
	esac

	if [ "${TASK}" != "s3_upload" ] && "${CLEAN_TARGET}" ; then
		clean_target || fail "Failed to clean out the target directory [${TARGET_DIR}]"
	fi

	run_task
) &
TASK_PID="${!}"

# Make pod deletions quick: we're PID 1, so SIGTERM is otherwise ignored
trap "exit 143" TERM INT

RC="0"
wait "${TASK_PID}" || RC="${?}"

if [ "${RC}" -eq 0 ] ; then
	ok "All work completed successfully"
else
	err "The work failed (rc = ${RC})"
fi

# The creation of this file will signal the pod as ready,
# which in turn means that the work is complete - whatever
# the outcome...
echo -n "${RC}" > "${RESULT_MARKER}"

#
# Since we're part of a StatefulSet, we have to wait forever...
#
while true ; do
	/usr/bin/sleep 3600 &
	wait "${!}" || true
done
