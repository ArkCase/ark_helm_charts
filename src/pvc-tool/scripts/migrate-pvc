#!/bin/bash
SCRIPT="$(/usr/bin/readlink -f "${BASH_ARGV0:-${BASH_SOURCE:-${0}}}")"
SCRIPT="$(/usr/bin/basename "${SCRIPT}")"

set -euo pipefail

#
# Copies the data for one PVC, depending on ${TASK_MODE} (and ${S3_DIRECTION},
# and ${S3_FORMAT}):
#
#   clone:              from ${SOURCE_DIR} into the new PVC at ${TARGET_DIR}, via rsync
#   s3 upload (tar):    from ${SOURCE_DIR} into s3://${S3_BUCKET}/${S3_PREFIX}.tar.gz
#   s3 download (tar):  from s3://${S3_BUCKET}/${S3_PREFIX}.tar.gz into ${TARGET_DIR}
#   s3 upload (mirror): from ${SOURCE_DIR} into s3://${S3_BUCKET}/${S3_PREFIX}/, via s3-fs-mirror
#   s3 download (mirror): from s3://${S3_BUCKET}/${S3_PREFIX}/ into ${TARGET_DIR}, via s3-fs-mirror
#
# Either way, the target (except lost+found) ends up as an exact copy of the
# source. rsync and s3-fs-mirror delete what isn't in the source, and skip what
# already matches, so a restarted copy resumes where the previous one left off
# (s3-fs-mirror even resumes partly transferred files). A download of a tar
# archive has to re-read the whole archive anyway, so the target is emptied
# before each attempt. Any arguments are passed on to s3-fs-mirror.
#
# The work is attempted up to ${MAX_ATTEMPTS} times, and the script exits with
# the outcome (we're a Job's pod: it either completes, or fails).
#

DEFAULT_MAX_ATTEMPTS="5"

# Left at the root of a restored PVC, to tell later attempts what was restored into it
RESTORE_MARKER=".pvc-tool-restore"

# Returned by an attempt that failed in a way that retrying won't fix
NO_RETRY_RC="100"

timestamp()
{
	/usr/bin/date -Ins -u
}

say()
{
	echo -e "$(timestamp): ${@}"
}

ok()
{
	say "✅ ${@}"
}

warn()
{
	say "⚠️ ${@}"
}

err()
{
	say "❌ ${@}"
}

fail()
{
	err "${@}"
	exit "${EXIT_CODE:-1}"
}

to_boolean()
{
	case "${1,,}" in
		true | t | yes | y ) echo -n "true" ;;
		* ) echo -n "false" ;;
	esac
}

is_valid_name()
{
	local NAME="${1}"
	[[ "${NAME}" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] || return 1
	return 0
}

ensure_dir()
{
	local DIR="${1}"
	[ -e "${DIR}" ] || fail "The directory [${DIR}] does not exist"
	[ -d "${DIR}" ] || fail "The path [${DIR}] is not a directory"
	[ -r "${DIR}" ] || fail "The directory [${DIR}] is not readable"
	[ -x "${DIR}" ] || fail "The directory [${DIR}] is not executable"
	return 0
}

ensure_target_dir()
{
	ensure_dir "${TARGET_DIR}"
	[ -w "${TARGET_DIR}" ] || fail "The directory [${TARGET_DIR}] is not writable"
	[ "$(/usr/bin/readlink -f "${TARGET_DIR}")" != "/" ] || fail "The target directory may not be the root directory"
	return 0
}

clean_target()
{
	say "🧹 Removing the existing contents of [${TARGET_DIR}] (except lost+found)..."
	/usr/bin/find "${TARGET_DIR}" -mindepth 1 -maxdepth 1 ! -name "lost+found" -exec /usr/bin/rm -rf -- "{}" + || return 1
	ok "The target directory is clean"
	return 0
}

#
# List the contents of the current directory such that two copies of
# the same data produce the same output: type, mode, ownership, size
# (except for directories, whose size depends on the filesystem), and
# path, sorted by path
#
list_contents()
{
	/usr/bin/find . \
		-path "./lost+found" -prune -o \
		-path "./${RESTORE_MARKER}" -prune -o \
		\( -type d -printf "%p\t%y %m %U:%G\n" \) -o \
		-printf "%p\t%y %m %U:%G %s\n" | LC_ALL="C" /usr/bin/sort
}

verify_clone()
{
	say "👀 Verifying the copy's correctness"
	local OLD_LIST="${WORK_DIR}/source.list"
	local NEW_LIST="${WORK_DIR}/target.list"
	( cd "${SOURCE_DIR}" && list_contents ) > "${OLD_LIST}" || { err "Failed to list the source's contents" ; return 1 ; }
	( cd "${TARGET_DIR}" && list_contents ) > "${NEW_LIST}" || { err "Failed to list the target's contents" ; return 1 ; }

	if ! /usr/bin/cmp -s "${OLD_LIST}" "${NEW_LIST}" ; then
		err "The source and target contents differ (showing up to 100 lines of differences):"
		/usr/bin/diff "${OLD_LIST}" "${NEW_LIST}" | /usr/bin/head -n 100 || true
		return 1
	fi

	ok "Copy verified ($(/usr/bin/wc -l < "${OLD_LIST}") entries)"
	return 0
}

run_clone()
{
	local CMD=(
		"${RSYNC}"
		-aHS
		--numeric-ids
		--delete-delay
		--exclude="/lost+found"
		--human-readable
		--stats
		"${SOURCE_DIR}/"
		"${TARGET_DIR}/"
	)
	say "👀 Will use the command: ${CMD[@]@Q}"

	local RC="0"
	"${CMD[@]}" || RC="${?}"
	case "${RC}" in
		0 ) ;;
		30 ) warn "Timeout detected" ; return "${RC}" ;;
		* ) err "Failed to copy the data (rc = ${RC})" ; return "${RC}" ;;
	esac

	verify_clone || return "${?}"
	return 0
}

run_s3_mirror()
{
	local DIRECTION="${1}"
	local CMD=( "${S3FSM}" "${DIRECTION}" "${S3FSM_FLAGS[@]}" )
	if [ "${DIRECTION}" == "upload" ] ; then
		CMD+=( "${SOURCE_DIR}" "${S3_URL}" )
	else
		CMD+=( "${S3_URL}" "${TARGET_DIR}" )
	fi
	say "👀 Will use the command: ${CMD[@]@Q}"

	local RC="0"
	"${CMD[@]}" || RC="${?}"
	if [ "${RC}" -ne 0 ] ; then
		err "Failed to ${DIRECTION} the data (rc = ${RC})"
		return "${RC}"
	fi
	ok "The ${DIRECTION} is complete"
	return 0
}

run_s3_mirror_upload()
{
	run_s3_mirror upload
}

run_s3_mirror_download()
{
	run_s3_mirror download
}

#
# Compare the archive in S3 against the given directory, with tar --diff:
# every member's type, permissions, ownership, size, modification time and
# contents must match (files that aren't in the archive are ignored)
#
verify_s3()
{
	local DIR="${1}"
	say "👀 Verifying [${S3_URL}] against [${DIR}]..."
	local CMD=(
		"${TAR}"
		--diff
		--gzip
		--file=-
		--directory="${DIR}"
		--numeric-owner
		"${TAR_FLAGS[@]}"
	)
	local DIFF="${WORK_DIR}/tar.diff"
	local RC="0"
	"${AWS}" "${AWS_FLAGS[@]}" s3 cp --only-show-errors "${S3_URL}" - | "${CMD[@]}" > "${DIFF}" 2>&1 || RC="${?}"
	if [ "${RC}" -ne 0 ] ; then
		err "The archive and [${DIR}] differ, or the comparison failed (rc = ${RC}) - showing up to 100 lines of output:"
		/usr/bin/head -n 100 "${DIFF}" || true
		return 1
	fi

	ok "Archive verified"
	return 0
}

is_missing_object()
{
	local OUT="${1}"
	[[ "${OUT}" == *"Not Found"* ]] || [[ "${OUT}" == *"(404)"* ]] || [[ "${OUT}" == *"NoSuchKey"* ]]
}

#
# What identifies this very instance of an object in S3: its ETag, size, modification
# time and version, on one line
#
object_identity()
{
	local KEY="${1}"
	"${AWS}" "${AWS_FLAGS[@]}" s3api head-object --bucket "${S3_BUCKET}" --key "${KEY}" --query "[ETag, ContentLength, LastModified, VersionId]" --output text
}

# The value of the given key in the given record (key=value lines)
record_value()
{
	local RECORD="${1}"
	local KEY="${2}"
	/usr/bin/sed -n -e "s/^${KEY}=//p" <<< "${RECORD}" | /usr/bin/head -n 1
}

#
# Whether the current archive and listing in S3 are the ones the given record describes
#
matches_objects()
{
	local RECORD="${1}"
	local CURRENT=""
	CURRENT="$(object_identity "${S3_TAR_KEY}" 2>/dev/null)" || { say "👀 The archive is gone" ; return 1 ; }
	[ "${CURRENT}" == "$(record_value "${RECORD}" "archive")" ] || { say "👀 The archive isn't the one recorded (it was replaced)" ; return 1 ; }
	CURRENT="$(object_identity "${S3_LISTING_KEY}" 2>/dev/null)" || { say "👀 The listing is gone" ; return 1 ; }
	[ "${CURRENT}" == "$(record_value "${RECORD}" "listing")" ] || { say "👀 The listing isn't the one recorded (it was replaced)" ; return 1 ; }
	return 0
}

#
# Whether the given directory's contents still match the stored listing (quietly)
#
matches_listing()
{
	local DIR="${1}"
	local OLD_LIST="${WORK_DIR}/recorded.list"
	"${AWS}" "${AWS_FLAGS[@]}" s3 cp --only-show-errors "${S3_LISTING_URL}" - 2>/dev/null | /usr/bin/gzip -dc > "${OLD_LIST}" 2>/dev/null || return 1
	( cd "${DIR}" && list_contents ) | /usr/bin/cmp -s - "${OLD_LIST}"
}

#
# Whether the source was already exported, and nothing changed since: its record exists,
# the archive and listing are the very ones it describes, no entry in the source changed
# (by its ctime, which nothing can set back) since the export started, and the source
# still matches the listing. Returns 0 if so, 1 if it needs exporting, 2 on errors
#
is_exported()
{
	local RECORD=""
	local OUT=""
	if ! RECORD="$("${AWS}" "${AWS_FLAGS[@]}" s3 cp --only-show-errors "${S3_RECORD_URL}" - 2> "${WORK_DIR}/record.err")" ; then
		OUT="$(< "${WORK_DIR}/record.err")"
		is_missing_object "${OUT}" && return 1
		err "Failed to read the export's record [${S3_RECORD_URL}]: ${OUT}"
		return 2
	fi

	say "👀 Found the record of an earlier export, checking whether it's still good..."
	local STARTED="$(record_value "${RECORD}" "started")"
	[[ "${STARTED}" =~ ^[0-9]+([.][0-9]+)?$ ]] || { warn "The export's record is malformed" ; return 1 ; }
	matches_objects "${RECORD}" || return 1

	local CHANGED=""
	CHANGED="$(cd "${SOURCE_DIR}" && /usr/bin/find . -path "./lost+found" -prune -o -path "./${RESTORE_MARKER}" -prune -o -newerct "@${STARTED}" -print -quit)" || { err "Failed to look for changes in the source" ; return 2 ; }
	[ -z "${CHANGED}" ] || { say "👀 The source changed since the export started (e.g. ${CHANGED@Q})" ; return 1 ; }

	matches_listing "${SOURCE_DIR}" || { say "👀 The source doesn't match the export's listing" ; return 1 ; }
	return 0
}

#
# Whether the target was already restored from the current archive, and nothing changed
# since: its marker describes the current archive and listing, no entry in the target
# changed (by its ctime) after the marker, and the target matches the listing. Returns 0
# if so, 1 if it needs restoring
#
is_restored()
{
	local MARKER="${TARGET_DIR}/${RESTORE_MARKER}"
	[ -f "${MARKER}" ] || return 1
	say "👀 Found the marker of an earlier restore, checking whether it's still good..."

	matches_objects "$(< "${MARKER}")" || return 1

	local CHANGED=""
	CHANGED="$(cd "${TARGET_DIR}" && /usr/bin/find . -path "./lost+found" -prune -o -path "./${RESTORE_MARKER}" -prune -o -cnewer "${MARKER}" -print -quit)" || return 1
	[ -z "${CHANGED}" ] || { say "👀 The target changed since it was restored (e.g. ${CHANGED@Q})" ; return 1 ; }

	matches_listing "${TARGET_DIR}" || { say "👀 The target doesn't match the export's listing" ; return 1 ; }
	return 0
}

#
# Leave the marker that is_restored() looks for. It must be newer than every change the
# restore made, so it's touched once more a moment later (file times are coarse). The
# target directory's own modification time (which adding the marker changes) is put
# back as the archive left it
#
mark_restored()
{
	local MARKER="${TARGET_DIR}/${RESTORE_MARKER}"
	local ARCHIVE=""
	local LISTING=""
	local ROOT_MTIME=""
	ARCHIVE="$(object_identity "${S3_TAR_KEY}")" || { err "Failed to read the archive's details" ; return 1 ; }
	LISTING="$(object_identity "${S3_LISTING_KEY}" 2>/dev/null)" || LISTING=""
	ROOT_MTIME="$(/usr/bin/stat -c "%.9Y" "${TARGET_DIR}")" || { err "Failed to read the target's modification time" ; return 1 ; }
	printf 'version=1\narchive=%s\nlisting=%s\n' "${ARCHIVE}" "${LISTING}" > "${MARKER}.tmp" && /usr/bin/mv -f "${MARKER}.tmp" "${MARKER}" || { err "Failed to write the restore marker" ; return 1 ; }
	/usr/bin/touch -m -d "@${ROOT_MTIME}" "${TARGET_DIR}" || warn "Failed to restore the target's modification time"
	/usr/bin/sleep 1
	/usr/bin/touch "${MARKER}" || { err "Failed to touch the restore marker" ; return 1 ; }
	ok "Restore recorded in [${MARKER}]"
	return 0
}

run_s3_tar_upload()
{
	local RC="0"
	is_exported || RC="${?}"
	case "${RC}" in
		0 ) ok "Already exported, and nothing changed since: there's nothing to do" ; return 0 ;;
		1 ) ;;
		* ) return 1 ;;
	esac

	# Until the new record is stored, the export isn't complete
	"${AWS}" "${AWS_FLAGS[@]}" s3 rm --only-show-errors "${S3_RECORD_URL}" || { err "Failed to remove the earlier export's record" ; return 1 ; }

	# Anything that changes after this moment calls for another export
	local STARTED=""
	STARTED="$(/usr/bin/date "+%s.%N")"

	# The AWS CLI needs an idea of the stream's size to pick a multipart chunk
	# size that can handle it (the default only reaches ~78GiB)
	local SIZE=""
	SIZE="$(/usr/bin/du -sb "${SOURCE_DIR}" | /usr/bin/awk '{ print $1 }')" || { err "Failed to compute the source's size" ; return 1 ; }
	say "👀 The source data is ${SIZE} bytes (uncompressed)"

	local TAR_CMD=(
		"${TAR}"
		--create
		--gzip
		--file=-
		--directory="${SOURCE_DIR}"
		--numeric-owner
		--sparse
		"${TAR_FLAGS[@]}"
		--exclude="./lost+found"
		--exclude="./${RESTORE_MARKER}"
		.
	)
	local AWS_CMD=(
		"${AWS}" "${AWS_FLAGS[@]}" s3 cp
		--only-show-errors
		--expected-size "${SIZE}"
		-
		"${S3_URL}"
	)
	say "👀 Will use the command: ${TAR_CMD[@]@Q} | ${AWS_CMD[@]@Q}"

	RC="0"
	"${TAR_CMD[@]}" | "${AWS_CMD[@]}" || RC="${?}"
	if [ "${RC}" -ne 0 ] ; then
		err "Failed to upload the data (rc = ${RC})"
		return "${RC}"
	fi
	ok "Upload complete"

	if "${S3_VERIFY}" ; then
		verify_s3 "${SOURCE_DIR}" || return "${?}"
	fi

	# The source's listing goes next to the archive, so a download can tell
	# whether it got everything back
	say "👀 Storing the source's listing as [${S3_LISTING_URL}]..."
	RC="0"
	( cd "${SOURCE_DIR}" && list_contents ) | /usr/bin/gzip -9 | "${AWS}" "${AWS_FLAGS[@]}" s3 cp --only-show-errors - "${S3_LISTING_URL}" || RC="${?}"
	if [ "${RC}" -ne 0 ] ; then
		err "Failed to store the source's listing (rc = ${RC})"
		return "${RC}"
	fi
	ok "Listing stored"

	# The record goes last: it says the export is complete, and what it consists of
	local ARCHIVE=""
	local LISTING=""
	ARCHIVE="$(object_identity "${S3_TAR_KEY}")" || { err "Failed to read back the archive's details" ; return 1 ; }
	LISTING="$(object_identity "${S3_LISTING_KEY}")" || { err "Failed to read back the listing's details" ; return 1 ; }
	printf 'version=1\nstarted=%s\narchive=%s\nlisting=%s\n' "${STARTED}" "${ARCHIVE}" "${LISTING}" | "${AWS}" "${AWS_FLAGS[@]}" s3 cp --only-show-errors - "${S3_RECORD_URL}" || { err "Failed to store the export's record" ; return 1 ; }
	ok "Export recorded in [${S3_RECORD_URL}]"
	return 0
}



run_s3_tar_download()
{
	# Make sure there's something to download
	local OUT=""
	if ! OUT="$("${AWS}" "${AWS_FLAGS[@]}" s3api head-object --bucket "${S3_BUCKET}" --key "${S3_TAR_KEY}" --query "ContentLength" --output text 2>&1)" ; then
		if is_missing_object "${OUT}" ; then
			err "The archive [${S3_URL}] does not exist"
			return "${NO_RETRY_RC}"
		fi
		err "Failed to look up the archive [${S3_URL}]: ${OUT}"
		return 1
	fi
	say "👀 The archive is ${OUT} bytes (compressed)"

	local RC="0"
	is_restored || RC="${?}"
	case "${RC}" in
		0 ) ok "Already restored from this very archive, and nothing changed since: there's nothing to do" ; return 0 ;;
		1 ) ;;
		* ) return 1 ;;
	esac

	# tar can't tell which existing files already match the archive (its skip
	# options would keep files left half-written by an interrupted attempt), and
	# it can't remove the files that aren't in the archive, so start from scratch
	clean_target || return 1

	local AWS_CMD=(
		"${AWS}" "${AWS_FLAGS[@]}" s3 cp
		--only-show-errors
		"${S3_URL}"
		-
	)
	local TAR_CMD=(
		"${TAR}"
		--extract
		--gzip
		--file=-
		--directory="${TARGET_DIR}"
		--numeric-owner
		--same-owner
		--same-permissions
		"${TAR_FLAGS[@]}"
	)
	say "👀 Will use the command: ${AWS_CMD[@]@Q} | ${TAR_CMD[@]@Q}"

	RC="0"
	"${AWS_CMD[@]}" | "${TAR_CMD[@]}" || RC="${?}"
	if [ "${RC}" -ne 0 ] ; then
		err "Failed to download and extract the data (rc = ${RC})"
		return "${RC}"
	fi
	ok "Download complete"

	if "${S3_VERIFY}" ; then
		verify_s3 "${TARGET_DIR}" || return "${?}"
	fi

	verify_listing || return "${?}"

	mark_restored || return 1
	return 0
}


#
# Compare the target's contents against the listing the upload stored for its
# source: every entry's path, type, permissions, ownership and size must match
#
verify_listing()
{
	local OLD_LIST="${WORK_DIR}/source.list"
	local NEW_LIST="${WORK_DIR}/target.list"
	local OUT=""
	if ! OUT="$("${AWS}" "${AWS_FLAGS[@]}" s3 cp --only-show-errors "${S3_LISTING_URL}" - 2>&1 > "${OLD_LIST}.gz")" ; then
		if is_missing_object "${OUT}" ; then
			warn "There's no listing of the source at [${S3_LISTING_URL}] (it was uploaded by an older version?), can't compare against it"
			return 0
		fi
		err "Failed to download the source's listing from [${S3_LISTING_URL}]: ${OUT}"
		return 1
	fi
	/usr/bin/gzip -dc < "${OLD_LIST}.gz" > "${OLD_LIST}" || { err "Failed to decompress the source's listing" ; return 1 ; }
	( cd "${TARGET_DIR}" && list_contents ) > "${NEW_LIST}" || { err "Failed to list the target's contents" ; return 1 ; }

	if ! /usr/bin/cmp -s "${OLD_LIST}" "${NEW_LIST}" ; then
		err "The target's contents differ from the source's listing (showing up to 100 lines of differences):"
		/usr/bin/diff "${OLD_LIST}" "${NEW_LIST}" | /usr/bin/head -n 100 || true
		# The archive itself must be off, so trying again won't help
		return "${NO_RETRY_RC}"
	fi

	ok "The target matches the source's listing ($(/usr/bin/wc -l < "${OLD_LIST}") entries)"
	return 0
}

run_task()
{
	local ATTEMPT=""
	local RC=""
	for (( ATTEMPT = 1 ; ATTEMPT <= MAX_ATTEMPTS ; ATTEMPT++ )) ; do
		say "👉 Starting attempt # ${ATTEMPT} of ${MAX_ATTEMPTS}..."
		RC="0"
		"run_${TASK}" || RC="${?}"
		if [ "${RC}" -eq 0 ] ; then
			ok "Work complete!"
			return 0
		fi
		if [ "${RC}" -eq "${NO_RETRY_RC}" ] ; then
			err "Attempt # ${ATTEMPT} failed, and retrying won't help"
			return 1
		fi
		warn "Attempt # ${ATTEMPT} failed"
	done
	err "The work could not be completed after ${MAX_ATTEMPTS} attempts"
	return 1
}

[ -v LOGS_DIR ] || LOGS_DIR=""
[ -n "${LOGS_DIR}" ] || LOGS_DIR="/logs"

[ -v MAX_ATTEMPTS ] || MAX_ATTEMPTS=""
[[ "${MAX_ATTEMPTS}" =~ ^[1-9][0-9]*$ ]] || MAX_ATTEMPTS="${DEFAULT_MAX_ATTEMPTS}"

LOG_BASE="${SCRIPT}"
STAMP="$(/usr/bin/date -u "+%Y%m%d-%H%M%SZ")"
MAIN_LOG="${LOGS_DIR}/${LOG_BASE}.${STAMP}.log"

say "👀 Logging to [${MAIN_LOG}]"
exec > >(/usr/bin/tee "${MAIN_LOG}")
TEE_PID="${!}"
exec 2>&1

# These go to s3-fs-mirror
EXTRA_ARGS=("${@}")

#
# Run the work in a subshell, so any failure in it (including
# the validations) still produces a result
#
(
	set -euo pipefail

	[ -v TASK_MODE ] || TASK_MODE=""
	TASK_MODE="${TASK_MODE,,}"
	[ -v S3_DIRECTION ] || S3_DIRECTION=""
	S3_DIRECTION="${S3_DIRECTION,,}"
	case "${TASK_MODE}" in
		clone ) TASK="clone" ;;
		s3 )
			[ -v S3_FORMAT ] || S3_FORMAT=""
			S3_FORMAT="${S3_FORMAT,,}"
			case "${S3_FORMAT}" in
				"" | tar ) S3_FORMAT="tar" ;;
				mirror ) ;;
				* ) fail "Unsupported S3_FORMAT value [${S3_FORMAT}]" ;;
			esac
			case "${S3_DIRECTION}" in
				"" | upload ) TASK="s3_${S3_FORMAT}_upload" ;;
				download ) TASK="s3_${S3_FORMAT}_download" ;;
				* ) fail "Unsupported S3_DIRECTION value [${S3_DIRECTION}]" ;;
			esac
			;;
		* ) fail "Unsupported TASK_MODE value [${TASK_MODE}]" ;;
	esac

	[ -v POD_NAME ] || POD_NAME="${HOSTNAME}"

	[ -v SOURCE_DIR ] || SOURCE_DIR=""
	[ -n "${SOURCE_DIR}" ] || SOURCE_DIR="/source"
	[ -v SOURCE_PVC ] || SOURCE_PVC=""
	[ -v TARGET_DIR ] || TARGET_DIR=""
	[ -n "${TARGET_DIR}" ] || TARGET_DIR="/target"
	[ -v TARGET_PVC ] || TARGET_PVC=""

	# The PVC this pod was deployed for: the source, except when downloading into it
	if [[ "${TASK}" == s3_*_download ]] ; then
		PVC_VAR="TARGET_PVC"
	else
		PVC_VAR="SOURCE_PVC"
	fi
	PVC="${!PVC_VAR}"
	[ -n "${PVC}" ] || fail "The ${PVC_VAR} variable is not set"
	is_valid_name "${PVC}" || fail "The ${PVC_VAR} value [${PVC}] is not a valid PVC name"

	WORK_DIR="$(/usr/bin/mktemp -d)" || fail "Failed to create a work directory"

	case "${TASK}" in
		clone )
			ensure_dir "${SOURCE_DIR}"
			ensure_target_dir
			[ -n "${TARGET_PVC}" ] || TARGET_PVC="(unknown)"

			RSYNC="$(type -P rsync)" || fail "Failed to find rsync in the path"

			say "👉 Copying PVC ${SOURCE_PVC} into PVC ${TARGET_PVC}"
			;;

		s3_* )
			[ -v S3_BUCKET ] || S3_BUCKET=""
			[ -n "${S3_BUCKET}" ] || fail "The S3_BUCKET variable is not set"
			[ -v S3_PREFIX ] || S3_PREFIX=""
			[ -n "${S3_PREFIX}" ] || fail "The S3_PREFIX variable is not set"
			[ -v S3_REGION ] || S3_REGION=""
			[ -v S3_ENDPOINT ] || S3_ENDPOINT=""

			if [ "${S3_FORMAT}" == "tar" ] ; then
				[ -v S3_VERIFY ] || S3_VERIFY="true"
				S3_VERIFY="$(to_boolean "${S3_VERIFY}")"

				AWS="$(type -P aws)" || fail "Failed to find aws in the path"
				TAR="$(type -P tar)" || fail "Failed to find tar in the path"
				type -P gzip &>/dev/null || fail "Failed to find gzip in the path"

				AWS_FLAGS=()
				[ -n "${S3_REGION}" ] && AWS_FLAGS+=(--region "${S3_REGION}")
				[ -n "${S3_ENDPOINT}" ] && AWS_FLAGS+=(--endpoint-url "${S3_ENDPOINT}")

				# Preserve ACLs and extended attributes, if this tar can
				TAR_FLAGS=()
				TAR_HELP="$("${TAR}" --help 2>&1)" || true
				for FLAG in --acls --xattrs ; do
					[[ "${TAR_HELP}" == *"${FLAG}"* ]] && TAR_FLAGS+=("${FLAG}")
				done

				S3_TAR_KEY="${S3_PREFIX}.tar.gz"
				S3_URL="s3://${S3_BUCKET}/${S3_TAR_KEY}"
				S3_LISTING_KEY="${S3_PREFIX}.listing.gz"
				S3_LISTING_URL="s3://${S3_BUCKET}/${S3_LISTING_KEY}"
				S3_RECORD_URL="s3://${S3_BUCKET}/${S3_PREFIX}.record"
			else
				[ -v S3_RESUME ] || S3_RESUME=""
				[ -n "${S3_RESUME}" ] || S3_RESUME="verify"
				[ -v S3_CONCURRENCY ] || S3_CONCURRENCY=""
				[ -v S3_BWLIMIT ] || S3_BWLIMIT=""

				S3FSM="$(type -P s3-fs-mirror)" || fail "Failed to find s3-fs-mirror in the path"

				S3FSM_FLAGS=(
					--resume "${S3_RESUME}"
					--delete
					--exclude "/lost+found/"
				)
				[ -n "${S3_REGION}" ] && S3FSM_FLAGS+=(--region "${S3_REGION}")
				[ -n "${S3_ENDPOINT}" ] && S3FSM_FLAGS+=(--endpoint "${S3_ENDPOINT}")
				[ -n "${S3_CONCURRENCY}" ] && S3FSM_FLAGS+=(--concurrency "${S3_CONCURRENCY}")
				[ -n "${S3_BWLIMIT}" ] && S3FSM_FLAGS+=(--bwlimit "${S3_BWLIMIT}")
				S3FSM_FLAGS+=("${EXTRA_ARGS[@]}")

				S3_URL="s3://${S3_BUCKET}/${S3_PREFIX}"
			fi

			if [[ "${TASK}" == s3_*_upload ]] ; then
				ensure_dir "${SOURCE_DIR}"
				say "👉 Uploading PVC ${SOURCE_PVC} into [${S3_URL}]"
			else
				ensure_target_dir
				say "👉 Downloading [${S3_URL}] into PVC ${TARGET_PVC}"
			fi
			;;
	esac

	run_task
) &
TASK_PID="${!}"

# Make pod deletions quick: we're PID 1, so SIGTERM is otherwise ignored
trap "exit 143" TERM INT

RC="0"
wait "${TASK_PID}" || RC="${?}"

if [ "${RC}" -eq 0 ] ; then
	ok "All work completed successfully"
else
	err "The work failed (rc = ${RC})"
fi

# Let tee finish writing out the log before we go
exec 1>&- 2>&-
wait "${TEE_PID}" || true
exit "${RC}"
