#!/bin/bash
SCRIPT="$(readlink -f "${BASH_ARGV0:-${BASH_SOURCE:-${0}}}")"
BASEDIR="$(dirname "${SCRIPT}")"

set -euo pipefail

. "${BASEDIR}/pvc-migration.functions"

#
# Restores every namespace the layout table (on stdin) sends to the given target context,
# from wherever it was exported (by full-context-extract): it re-creates the namespaces
# and their PVCs, and restores the PVCs' data through the pvc-tool chart's transfer Jobs,
# which it then waits for (see wait-for-context-transfers). Then deploy the applications.
#
# A relocation is a namespace that comes from another context. They're restored along with
# the rest, unless --relocations says otherwise.
#
# Nothing is changed unless every namespace checks out first: its export is complete, its
# PVCs' storage classes exist here (or are mapped with -s), and if the namespace exists
# already, it has no PVCs other than the exported ones. Namespaces whose transfers were
# already started (the pvc-tool release is installed) are left alone, so this can be run
# again.
#

usage()
{
	echo -e "usage: ${BASH_SOURCE:-${0}} [-b bucket] [-r release] [-s old=new]... [--relocations include|exclude|only] target-context [-- helm-install-args...] < layout-table.txt" 1>&2
	echo -e "" 1>&2
	echo -e "	Restores the namespaces the layout table sends to the target context, and waits for" 1>&2
	echo -e "	the transfers to finish." 1>&2
	echo -e "" 1>&2
	echo -e "	-b, --bucket          The bucket (default: \${MIGRATION_BUCKET})" 1>&2
	echo -e "	-r, --release         The name of the pvc-tool release to install (default: ${DEFAULT_RELEASE})" 1>&2
	echo -e "	-s, --storage-class   Re-create the PVCs of storage class 'old' with the storage class 'new'" 1>&2
	echo -e "	                      (repeatable; '*=new' applies to every other storage class, and" 1>&2
	echo -e "	                      'old=' uses the cluster's default storage class)" 1>&2
	echo -e "	--relocations         include (default): restore every namespace sent here;" 1>&2
	echo -e "	                      exclude: only those that come from a context with the same name;" 1>&2
	echo -e "	                      only: only those that come from other contexts" 1>&2
	echo -e "" 1>&2
	echo -e "	Any arguments after -- are passed to 'helm install' (e.g. -f values.yaml, with the image," 1>&2
	echo -e "	s3.region and s3.irsaRole). Set CHART to use a chart other than ${CHART}." 1>&2
	echo -e "" 1>&2
	echo -e "	The layout table has one line per namespace (# starts a comment):" 1>&2
	echo -e "" 1>&2
	echo -e "		source-context  source-namespace  target-context  [target-namespace]" 1>&2
	exit 1
}

ARGS=()
while [ "${#}" -gt 0 ] ; do
	[ "${1}" == "--" ] && shift && break
	ARGS+=("${1}")
	shift
done
HELM_ARGS=("${@}")
set -- "${ARGS[@]}"

RELEASE="${DEFAULT_RELEASE}"
RELOCATIONS="include"
SC_MAP="{}"
POSITIONAL=()
while [ "${#}" -gt 0 ] ; do
	case "${1}" in
		-b | --bucket ) [ "${#}" -ge 2 ] || usage ; MIGRATION_BUCKET="${2}" ; shift 2 ;;
		-r | --release ) [ "${#}" -ge 2 ] || usage ; RELEASE="${2}" ; shift 2 ;;
		-s | --storage-class )
			[ "${#}" -ge 2 ] || usage
			[[ "${2}" =~ ^([^=]+)=(.*)$ ]] || fail "Invalid storage class mapping [${2}] - must be old=new"
			SC_MAP="$(jq -c --arg old "${BASH_REMATCH[1]}" --arg new "${BASH_REMATCH[2]}" '. + { ($old): $new }' <<< "${SC_MAP}")"
			shift 2
			;;
		--relocations )
			[ "${#}" -ge 2 ] || usage
			case "${2}" in
				include | exclude | only ) RELOCATIONS="${2}" ;;
				* ) fail "Invalid --relocations value [${2}] - must be include, exclude or only" ;;
			esac
			shift 2
			;;
		-* ) usage ;;
		* ) POSITIONAL+=("${1}") ; shift ;;
	esac
done
[ "${#POSITIONAL[@]}" -eq 1 ] || usage
TARGET="${POSITIONAL[0]}"
is_valid_context "${TARGET}" || fail "Invalid context name [${TARGET}]"
is_valid_name "${RELEASE}" || fail "Invalid release name [${RELEASE}]"
[ -n "${MIGRATION_BUCKET}" ] || fail "No bucket given (use -b, or set MIGRATION_BUCKET)"
is_valid_bucket "${MIGRATION_BUCKET}" || fail "Invalid bucket name [${MIGRATION_BUCKET}]"

read_layout

ROWS=()
SKIPPED="0"
for I in "${!LAYOUT_DST_CTX[@]}" ; do
	[ "${LAYOUT_DST_CTX[${I}]}" == "${TARGET}" ] || continue
	RELOCATED="false"
	[ "${LAYOUT_SRC_CTX[${I}]}" != "${TARGET}" ] && RELOCATED="true"
	case "${RELOCATIONS}" in
		exclude ) "${RELOCATED}" && { SKIPPED="$(( SKIPPED + 1 ))" ; continue ; } ;;
		only ) "${RELOCATED}" || { SKIPPED="$(( SKIPPED + 1 ))" ; continue ; } ;;
	esac
	ROWS+=("${I}")
done
if [ "${#ROWS[@]}" -eq 0 ] ; then
	ok "No transfers needed: the layout table sends no namespaces to ${TARGET} (with --relocations ${RELOCATIONS}; ${SKIPPED} skipped)"
	exit 0
fi
[ "${SKIPPED}" -gt 0 ] && say "⏩ Skipping ${SKIPPED} namespace(s), per --relocations ${RELOCATIONS}"

ensure_exe aws helm jq kubectl
ensure_context "${TARGET}"

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "${WORK_DIR}"' EXIT

# Check everything before changing anything
TODO=()
NAMESPACES=()
BAD="0"
for I in "${ROWS[@]}" ; do
	SRC_CTX="${LAYOUT_SRC_CTX[${I}]}"
	SRC_NS="${LAYOUT_SRC_NS[${I}]}"
	NS="${LAYOUT_DST_NS[${I}]}"
	FROM="${SRC_CTX}/${SRC_NS}"
	WHAT="${TARGET}/${NS} (from ${FROM})"
	NAMESPACES+=("${NS}")

	if is_release_installed "${TARGET}" "${NS}" ; then
		say "⏩ ${WHAT}: its transfers were already started"
		continue
	fi

	DIR="${WORK_DIR}/${I}"
	mkdir -p "${DIR}"
	URL="$(k8s_url "${SRC_CTX}" "${SRC_NS}")"
	if ! aws s3 cp --only-show-errors "${URL}/namespace.json" "${DIR}/namespace.json" 2>/dev/null || ! aws s3 cp --only-show-errors "${URL}/pvcs.json" "${DIR}/pvcs.json" 2>/dev/null ; then
		err "${WHAT}: it wasn't exported (no definitions in [${URL}/])"
		BAD="1"
		continue
	fi

	# Each PVC's listing is the last thing its export stores
	OBJECTS="$(list_exported_objects "${SRC_CTX}" "${SRC_NS}")" || { err "${WHAT}: failed to list its export" ; BAD="1" ; continue ; }
	MISSING=()
	while read -r PVC ; do
		[ -n "${PVC}" ] || continue
		awk -F '\t' -v key="${SRC_CTX}/${SRC_NS}/${PVC}.listing.gz" '$1 == key { found = 1 } END { exit !found }' <<< "${OBJECTS}" || MISSING+=("${PVC}")
	done < <(jq -r '.items[].metadata.name' "${DIR}/pvcs.json")
	if [ "${#MISSING[@]}" -gt 0 ] ; then
		err "${WHAT}: the export of these PVCs isn't complete: ${MISSING[*]}"
		BAD="1"
		continue
	fi

	jq --arg ns "${NS}" '.metadata.name = $ns' "${DIR}/namespace.json" > "${DIR}/namespace.new.json"
	rewrite_pvcs "${NS}" "${SC_MAP}" < "${DIR}/pvcs.json" > "${DIR}/pvcs.new.json"

	SC_MISSING=()
	while read -r SC ; do
		[ -n "${SC}" ] || continue
		kubectl --context "${TARGET}" get storageclass "${SC}" &>/dev/null || SC_MISSING+=("${SC}")
	done < <(jq -r '.items[].spec.storageClassName // empty' "${DIR}/pvcs.new.json" | sort -u)
	if [ "${#SC_MISSING[@]}" -gt 0 ] ; then
		err "${WHAT}: these storage classes don't exist in ${TARGET}: ${SC_MISSING[*]} (map them with -s old=new, e.g. -s ${SC_MISSING[0]}=gp3)"
		BAD="1"
		continue
	fi

	# The chart restores every PVC in the namespace, so they must all come from the export
	if kubectl --context "${TARGET}" get namespace "${NS}" &>/dev/null ; then
		EXTRA="$(kubectl --context "${TARGET}" get pvc --namespace "${NS}" -o json | jq -r --argjson want "$(jq -c '[.items[].metadata.name]' "${DIR}/pvcs.new.json")" '
			.items[]
			| select(.metadata.deletionTimestamp == null)
			| select((.spec.volumeMode // "Filesystem") == "Filesystem")
			| .metadata.name
			| select(. as $n | $want | index($n) | not)
		')" || { err "${WHAT}: failed to list its PVCs" ; BAD="1" ; continue ; }
		if [ -n "${EXTRA}" ] ; then
			err "${WHAT}: the namespace has PVCs that aren't part of the export: $(echo ${EXTRA})"
			BAD="1"
			continue
		fi
	fi

	TODO+=("${I}")
done
[ "${BAD}" -eq 0 ] || fail "Nothing was changed: fix the above, and run this again"

for I in "${TODO[@]}" ; do
	SRC_CTX="${LAYOUT_SRC_CTX[${I}]}"
	SRC_NS="${LAYOUT_SRC_NS[${I}]}"
	NS="${LAYOUT_DST_NS[${I}]}"
	WHAT="${TARGET}/${NS} (from ${SRC_CTX}/${SRC_NS})"
	DIR="${WORK_DIR}/${I}"

	if kubectl --context "${TARGET}" get namespace "${NS}" &>/dev/null ; then
		say "⏩ ${WHAT}: the namespace exists already"
	else
		kubectl --context "${TARGET}" create -f "${DIR}/namespace.new.json" >/dev/null || fail "${WHAT}: failed to create the namespace"
		ok "${WHAT}: created the namespace"
	fi

	PVCS=()
	readarray -t PVCS < <(jq -r '.items[].metadata.name' "${DIR}/pvcs.new.json")
	for PVC in "${PVCS[@]}" ; do
		if kubectl --context "${TARGET}" get pvc --namespace "${NS}" "${PVC}" &>/dev/null ; then
			say "⏩ ${WHAT}: the PVC ${PVC} exists already"
			continue
		fi
		jq --arg name "${PVC}" '.items[] | select(.metadata.name == $name)' "${DIR}/pvcs.new.json" | kubectl --context "${TARGET}" create -f - >/dev/null || fail "${WHAT}: failed to create the PVC ${PVC}"
	done

	if [ "${#PVCS[@]}" -eq 0 ] ; then
		ok "${WHAT}: no PVCs to restore"
		continue
	fi

	helm install "${RELEASE}" "${CHART}" \
		--kube-context "${TARGET}" \
		--namespace "${NS}" \
		"${HELM_ARGS[@]}" \
		--set mode=s3 \
		--set s3.format=tar \
		--set s3.direction=download \
		--set "s3.bucket=${MIGRATION_BUCKET}" \
		--set "s3.prefix=${SRC_CTX}" \
		--set "s3.namespace=${SRC_NS}" >/dev/null || fail "${WHAT}: failed to install the pvc-tool chart"
	ok "${WHAT}: restoring ${#PVCS[@]} PVC(s): ${PVCS[*]}"
done

exec "${BASEDIR}/wait-for-context-transfers" "${TARGET}" "${NAMESPACES[@]}"
