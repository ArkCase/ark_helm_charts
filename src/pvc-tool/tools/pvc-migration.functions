#!/bin/bash
#
# Shared by extract-namespace, restore-namespace, start-migrations, watch-migrations,
# wait-for-context-transfers and retry-context-transfers (it's sourced, not run).
#
# Each namespace's data goes into the bucket under ${sourceContext}/${sourceNamespace}/:
#
#   _k8s/namespace.json, _k8s/pvcs.json   the definitions to re-create them from
#   _k8s/original-*.json                  the same, as they were (for reference)
#   ${pvcName}.tar.gz                     each PVC's data (by the pvc-tool chart's Jobs)
#   ${pvcName}.listing.gz                 each PVC's listing (to check restores against)
#   ${pvcName}.record                     stored last: the PVC's export is complete, and
#                                         what it consists of (so it's never repeated
#                                         needlessly)
#

[ -v CHART ] || CHART=""
[ -n "${CHART}" ] || CHART="arkcase/pvc-tool"

[ -v MIGRATION_BUCKET ] || MIGRATION_BUCKET=""

MARKER_LABEL="armedia.com/pvc-mounter-name"
DEFAULT_RELEASE="pvc-tool"

# Annotations and labels that tie a namespace or PVC to its cluster (or Rancher)
LOCAL_NAMESPACE_KEYS="^((field|lifecycle|management)[.])?cattle[.]io/|^kubectl[.]kubernetes[.]io/last-applied-configuration$"
LOCAL_PVC_KEYS="^(pv|volume|volume[.]beta)[.]kubernetes[.]io/|^kubectl[.]kubernetes[.]io/last-applied-configuration$"

timestamp()
{
	date -Ins
}

say()
{
	echo -e "$(timestamp): ${@}"
}

ok()
{
	say "✅ ${@}"
}

warn()
{
	say "⚠️ ${@}"
}

err()
{
	say "❌ ${@}" 1>&2
}

fail()
{
	err "${@}"
	exit ${EXIT_CODE:-1}
}

is_valid_name()
{
	local NAME="${1}"
	[[ "${NAME}" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || return ${?}
	return 0
}

# Contexts name the data's location in the bucket, so they must be usable as a key prefix
is_valid_context()
{
	local NAME="${1}"
	[[ "${NAME}" =~ ^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9])?$ ]] || return ${?}
	return 0
}

is_valid_bucket()
{
	local NAME="${1}"
	[[ "${NAME}" =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$ ]] || return ${?}
	return 0
}

ensure_exe()
{
	local BAD=()
	for EXE in "${@}" ; do
		type -P "${EXE}" &>/dev/null || BAD+=("${EXE}")
	done

	[ ${#BAD[@]} -eq 0 ] && return 0

	fail "Could not find the following executables in the path: [${BAD[@]@Q}]"
}

ensure_context()
{
	local CONTEXT="${1}"
	kubectl config get-contexts "${CONTEXT}" &>/dev/null || fail "There's no kube context named [${CONTEXT}]"
	kubectl --context "${CONTEXT}" get namespace default &>/dev/null || fail "Can't reach the cluster for the context [${CONTEXT}]"
}

#
# Splits a "context/namespace" argument into CTX_PART and NS_PART (the namespace is
# optional when DEFAULT_NS is given)
#
parse_location()
{
	local ARG="${1}"
	local DEFAULT_NS="${2:-}"
	CTX_PART="${ARG%%/*}"
	NS_PART=""
	[[ "${ARG}" == */* ]] && NS_PART="${ARG#*/}"
	[ -n "${NS_PART}" ] || NS_PART="${DEFAULT_NS}"
	is_valid_context "${CTX_PART}" || fail "Invalid context name [${CTX_PART}] in [${ARG}] (letters, digits, '.', '_' and '-': it's part of the data's location in the bucket)"
	[ -n "${NS_PART}" ] || fail "No namespace in [${ARG}] (must be context/namespace)"
	is_valid_name "${NS_PART}" || fail "Invalid namespace name [${NS_PART}] in [${ARG}]"
	return 0
}

k8s_url()
{
	local SRC_CTX="${1}"
	local SRC_NS="${2}"
	echo -n "s3://${MIGRATION_BUCKET}/${SRC_CTX}/${SRC_NS}/_k8s"
}

# The annotation on a restored namespace that lists (comma-separated) the PVCs its restore left out,
# since their export was missing or incomplete (restore-namespace --skip-missing)
MISSING_PVCS_ANNOTATION="armedia.com/pvc-tool-missing-pvcs"

# The PVCs a restore of the given namespace left out (comma-separated), if any
missing_pvcs()
{
	local CONTEXT="${1}"
	local NAMESPACE="${2}"
	kubectl --context "${CONTEXT}" get namespace "${NAMESPACE}" -o json 2>/dev/null | jq -r --arg a "${MISSING_PVCS_ANNOTATION}" '.metadata.annotations[$a] // empty'
}

# Whether the pvc-tool release is installed in the given namespace (i.e. its work was started)
is_release_installed()
{
	local CONTEXT="${1}"
	local NAMESPACE="${2}"
	helm status "${RELEASE}" --kube-context "${CONTEXT}" --namespace "${NAMESPACE}" &>/dev/null
}

#
# The namespace's PVCs that pods other than ours (and that aren't done) are using,
# as "pvcName (pod podName)" lines
#
find_busy_pvcs()
{
	local CONTEXT="${1}"
	local NAMESPACE="${2}"
	kubectl --context "${CONTEXT}" get pod --namespace "${NAMESPACE}" -o json | jq -r --arg marker "${MARKER_LABEL}" '
		.items[]
		| select(.metadata.labels[$marker] == null)
		| select(.status.phase != "Succeeded" and .status.phase != "Failed")
		| .metadata.name as $pod
		| .spec.volumes[]?
		| select(.persistentVolumeClaim)
		| "\(.persistentVolumeClaim.claimName) (pod \($pod))"
	' | sort -u
}

#
# Stores the namespace's definition and its PVCs' definitions in the bucket, minus
# what ties them to this cluster: volumes, nodes, owners (e.g. StatefulSets, which
# would garbage-collect them), and Rancher projects. Helm's ownership marks are kept,
# so the application's chart adopts the PVCs it renders itself. Prints the names of
# the PVCs the chart will export (the same ones pvc-tool.plan picks).
#
export_definitions()
{
	local CONTEXT="${1}"
	local NAMESPACE="${2}"
	local DIR="${3}"
	local URL="$(k8s_url "${CONTEXT}" "${NAMESPACE}")"

	kubectl --context "${CONTEXT}" get namespace "${NAMESPACE}" -o json > "${DIR}/original-namespace.json" || return 1
	kubectl --context "${CONTEXT}" get pvc --namespace "${NAMESPACE}" -o json > "${DIR}/original-pvcs.json" || return 1

	jq --arg local "${LOCAL_NAMESPACE_KEYS}" '{
		apiVersion: "v1",
		kind: "Namespace",
		metadata: ({
			name: .metadata.name,
			labels: ((.metadata.labels // {}) | del(."kubernetes.io/metadata.name") | with_entries(select(.key | test($local) | not))),
			annotations: ((.metadata.annotations // {}) | with_entries(select(.key | test($local) | not)))
		} | with_entries(select(.value != {})))
	}' "${DIR}/original-namespace.json" > "${DIR}/namespace.json" || return 1

	jq --arg local "${LOCAL_PVC_KEYS}" '{
		apiVersion: "v1",
		kind: "List",
		items: [
			.items[]
			| select(.metadata.deletionTimestamp == null)
			| select((.spec.volumeMode // "Filesystem") == "Filesystem")
			| {
				apiVersion: "v1",
				kind: "PersistentVolumeClaim",
				metadata: ({
					name: .metadata.name,
					namespace: .metadata.namespace,
					labels: (.metadata.labels // {}),
					annotations: ((.metadata.annotations // {}) | with_entries(select(.key | test($local) | not)))
				} | with_entries(select(.value != {}))),
				spec: ({
					accessModes: .spec.accessModes,
					resources: { requests: .spec.resources.requests },
					storageClassName: .spec.storageClassName,
					volumeMode: (.spec.volumeMode // "Filesystem")
				} | with_entries(select(.value != null)))
			}
		]
	}' "${DIR}/original-pvcs.json" > "${DIR}/pvcs.json" || return 1

	local FILE=""
	for FILE in namespace.json pvcs.json original-namespace.json original-pvcs.json ; do
		aws s3 cp --only-show-errors "${DIR}/${FILE}" "${URL}/${FILE}" 1>&2 || return 1
	done

	jq -r '.items[] | select(.metadata.deletionTimestamp != null or (.spec.volumeMode // "Filesystem") != "Filesystem") | .metadata.name' "${DIR}/original-pvcs.json" | while read -r PVC ; do
		warn "${CONTEXT}/${NAMESPACE}: the PVC ${PVC} is being deleted, or isn't a filesystem: it won't be exported" 1>&2
	done

	jq -r '.items[].metadata.name' "${DIR}/pvcs.json" | sort
}

# The objects (key<TAB>size) under the given source namespace's location in the bucket
list_exported_objects()
{
	local SRC_CTX="${1}"
	local SRC_NS="${2}"
	aws s3api list-objects-v2 --bucket "${MIGRATION_BUCKET}" --prefix "${SRC_CTX}/${SRC_NS}/" --query "Contents[].[Key, Size]" --output text | grep -v '^None$' || true
}

#
# Applies the storage class map (JSON: { "old": "new", "*": "new" }, where "" means the
# default class), the new namespace, and Helm's release namespace to the PVC definitions
#
rewrite_pvcs()
{
	local NAMESPACE="${1}"
	local SC_MAP="${2}"
	jq --arg ns "${NAMESPACE}" --argjson map "${SC_MAP}" '
		.items |= map(
			.metadata.namespace = $ns
			| if .metadata.annotations."meta.helm.sh/release-namespace" then .metadata.annotations."meta.helm.sh/release-namespace" = $ns else . end
			| (.spec.storageClassName // null) as $old
			| if $old == null then .
			  else
				(if ($map | has($old)) then $map[$old] elif ($map | has("*")) then $map["*"] else $old end) as $new
				| if $new == "" then del(.spec.storageClassName) else .spec.storageClassName = $new end
			  end
		)
	'
}

# How many times --retry-only re-creates failed Jobs before giving up
DEFAULT_MAX_RETRIES="3"

#
# Waits for the transfer Jobs in the given namespaces, re-creating the failed ones up
# to MAX_RETRIES times. Returns like wait-for-context-transfers: 0 once all of them
# completed, 1 if some still fail after the last retry, 2 if the cluster can't be reached
#
wait_and_retry()
{
	local CONTEXT="${1}"
	shift
	local RETRIES="0"
	local RC=""
	while true ; do
		RC="0"
		"${BASEDIR}/wait-for-context-transfers" "${CONTEXT}" "${@}" || RC="${?}"
		[ "${RC}" -eq 1 ] || return "${RC}"
		if [ "${RETRIES}" -ge "${MAX_RETRIES}" ] ; then
			err "Some transfers in ${CONTEXT} still fail after ${MAX_RETRIES} retries: look into them before retrying again"
			return 1
		fi
		RETRIES="$(( RETRIES + 1 ))"
		say "🔁 Retrying the failed transfers in ${CONTEXT} (retry ${RETRIES} of ${MAX_RETRIES})"
		"${BASEDIR}/retry-context-transfers" "${CONTEXT}" "${@}" || return 1
	done
}

# Whether the namespace has PVCs that pvc-tool would work on
has_pvcs()
{
	local CONTEXT="${1}"
	local NAMESPACE="${2}"
	local COUNT=""
	COUNT="$(kubectl --context "${CONTEXT}" get pvc --namespace "${NAMESPACE}" -o json | jq '[.items[] | select(.metadata.deletionTimestamp == null) | select((.spec.volumeMode // "Filesystem") == "Filesystem")] | length')" || return 2
	[ "${COUNT}" -gt 0 ]
}

#
# For --retry-only: the given namespaces whose transfers were never started (no release,
# but there's work to do), one per line. For an export, that's a namespace with PVCs;
# for a restore, one that wasn't created yet, or whose PVCs were
#
find_unstarted()
{
	local CONTEXT="${1}"
	local DIRECTION="${2}"
	shift 2
	local NS=""
	local RC=""
	for NS in "${@}" ; do
		is_release_installed "${CONTEXT}" "${NS}" && continue
		if ! kubectl --context "${CONTEXT}" get namespace "${NS}" &>/dev/null ; then
			[ "${DIRECTION}" == "download" ] && echo "${NS}"
			continue
		fi
		RC="0"
		has_pvcs "${CONTEXT}" "${NS}" || RC="${?}"
		case "${RC}" in
			0 ) echo "${NS}" ;;
			1 ) ;;
			* ) return 1 ;;
		esac
	done
}

#
# The --retry-only mode: start nothing, just wait for (and retry) the transfers that
# were already started, and say which ones never were
#
retry_only()
{
	local CONTEXT="${1}"
	local DIRECTION="${2}"
	shift 2

	ensure_exe helm jq kubectl
	ensure_context "${CONTEXT}"

	local UNSTARTED=()
	readarray -t UNSTARTED < <(find_unstarted "${CONTEXT}" "${DIRECTION}" "${@}" ; echo "rc=${?}")
	[ "${UNSTARTED[-1]}" == "rc=0" ] || fail "Failed to check which transfers were started in ${CONTEXT}"
	unset 'UNSTARTED[-1]'
	if [ "${#UNSTARTED[@]}" -gt 0 ] ; then
		warn "These namespaces' transfers were never started, so they won't be waited for: ${UNSTARTED[*]}"
	fi

	local RC="0"
	wait_and_retry "${CONTEXT}" "${@}" || RC="${?}"

	if [ "${#UNSTARTED[@]}" -gt 0 ] ; then
		err "Not done: the transfers of ${UNSTARTED[*]} were never started (run this again without --retry-only to start them)"
		[ "${RC}" -ne 0 ] || RC="1"
	fi
	return "${RC}"
}

#
# The transfer Jobs in the given context (only those in the given namespaces, a JSON list,
# unless it's empty), one per line: state (complete, failed or running), namespace, name,
# the PVC it works on, and (for failures) why
#
list_transfer_jobs()
{
	local CONTEXT="${1}"
	local NAMESPACES_JSON="${2:-[]}"
	kubectl --context "${CONTEXT}" get job --all-namespaces --selector "${MARKER_LABEL}" -o json | jq -r --argjson namespaces "${NAMESPACES_JSON}" '
		.items[]
		| select(($namespaces | length) == 0 or (.metadata.namespace as $ns | $namespaces | index($ns)))
		| (.status.conditions // []) as $c
		| (if any($c[]; (.type == "Failed" or .type == "FailureTarget") and .status == "True") then "failed"
		   elif any($c[]; .type == "Complete" and .status == "True") then "complete"
		   else "running" end) as $state
		| [
			$state,
			.metadata.namespace,
			.metadata.name,
			(.metadata.annotations["armedia.com/pvc-tool-source"] // .metadata.annotations["armedia.com/pvc-tool-target"] // "?"),
			([$c[] | select((.type == "Failed" or .type == "FailureTarget") and .status == "True") | "\(.reason): \(.message)"] | first // "")
		  ]
		| @tsv
	' | sort -k2,3
}

#
# A Job, as it'd have to be created anew to run again: Kubernetes fills in the selector,
# the pod labels that go with it, and the status (reads the Job's JSON from stdin)
#
job_for_recreation()
{
	jq -c '{
		apiVersion,
		kind,
		metadata: { name: .metadata.name, namespace: .metadata.namespace, labels: .metadata.labels, annotations: .metadata.annotations },
		spec: (.spec
			| del(.selector, .manualSelector)
			| .template.metadata.labels |= with_entries(select(.key | test("^(batch[.]kubernetes[.]io/)?(controller-uid|job-name)$") | not)))
	}'
}

# Re-creates the given Job, so it runs again
recreate_job()
{
	local CONTEXT="${1}"
	local NAMESPACE="${2}"
	local JOB="${3}"
	local JSON=""
	JSON="$(kubectl --context "${CONTEXT}" get job --namespace "${NAMESPACE}" "${JOB}" -o json | job_for_recreation)" || return 1
	kubectl --context "${CONTEXT}" replace --force -f - <<< "${JSON}" >/dev/null
}

#
# Reads the migrations table from stdin into the arrays MIG_SRC_CTX, MIG_SRC_NS,
# MIG_DST_CTX and MIG_DST_NS (one entry per line), one line per namespace:
#
#   source-context/namespace   target-context[/namespace] | -
#
# A target of "-" means the namespace stays where it is (the same context and name), and
# a target without a namespace keeps the source's name. Blank lines, and everything after
# a #, are ignored. No two lines may have the same source, or the same target
#
read_migrations()
{
	MIG_SRC_CTX=()
	MIG_SRC_NS=()
	MIG_DST_CTX=()
	MIG_DST_NS=()

	[ -t 0 ] && fail "The migrations table must be given on stdin (e.g. ${0##*/} ... < migrations.txt)"

	local -A SEEN_SRC=()
	local -A SEEN_DST=()
	local LINE=""
	local NUM="0"
	local BAD="0"
	local FIELDS=()
	while IFS="" read -r LINE || [ -n "${LINE}" ] ; do
		NUM="$(( NUM + 1 ))"
		LINE="${LINE%%#*}"
		read -r -a FIELDS <<< "${LINE}"
		[ "${#FIELDS[@]}" -eq 0 ] && continue
		if [ "${#FIELDS[@]}" -ne 2 ] ; then
			err "Migrations line ${NUM}: expected 'source-context/namespace target-context[/namespace]|-', got [${LINE}]"
			BAD="1"
			continue
		fi
		( parse_location "${FIELDS[0]}" ) 2>/dev/null || { err "Migrations line ${NUM}: [${FIELDS[0]}] isn't a valid context/namespace" ; BAD="1" ; continue ; }
		parse_location "${FIELDS[0]}"
		local SRC_CTX="${CTX_PART}"
		local SRC_NS="${NS_PART}"
		local DST_CTX="${SRC_CTX}"
		local DST_NS="${SRC_NS}"
		if [ "${FIELDS[1]}" != "-" ] ; then
			( parse_location "${FIELDS[1]}" "${SRC_NS}" ) 2>/dev/null || { err "Migrations line ${NUM}: [${FIELDS[1]}] isn't a valid context[/namespace]" ; BAD="1" ; continue ; }
			parse_location "${FIELDS[1]}" "${SRC_NS}"
			DST_CTX="${CTX_PART}"
			DST_NS="${NS_PART}"
		fi
		if [ -n "${SEEN_SRC["${SRC_CTX}/${SRC_NS}"]:-}" ] ; then
			err "Migrations line ${NUM}: ${SRC_CTX}/${SRC_NS} is already on line ${SEEN_SRC["${SRC_CTX}/${SRC_NS}"]}"
			BAD="1"
			continue
		fi
		if [ -n "${SEEN_DST["${DST_CTX}/${DST_NS}"]:-}" ] ; then
			err "Migrations line ${NUM}: ${DST_CTX}/${DST_NS} is already the target on line ${SEEN_DST["${DST_CTX}/${DST_NS}"]}"
			BAD="1"
			continue
		fi
		SEEN_SRC["${SRC_CTX}/${SRC_NS}"]="${NUM}"
		SEEN_DST["${DST_CTX}/${DST_NS}"]="${NUM}"
		MIG_SRC_CTX+=("${SRC_CTX}")
		MIG_SRC_NS+=("${SRC_NS}")
		MIG_DST_CTX+=("${DST_CTX}")
		MIG_DST_NS+=("${DST_NS}")
	done
	[ "${BAD}" -eq 0 ] || fail "The migrations table has errors"
	return 0
}

#
# For start-migrations and watch-migrations: the rows of the migrations table to work on
# (into ROWS), given the direction (the context the work runs in is the source's when
# extracting, and the target's when restoring), and the -c filter (CONTEXT_FILTER, an
# associative array, all contexts if empty)
#
select_rows()
{
	local DIRECTION="${1}"
	ROWS=()
	local I=""
	for I in "${!MIG_SRC_CTX[@]}" ; do
		local CTX="$(row_context "${DIRECTION}" "${I}")"
		if [ "${#CONTEXT_FILTER[@]}" -gt 0 ] && [ -z "${CONTEXT_FILTER["${CTX}"]:-}" ] ; then
			continue
		fi
		ROWS+=("${I}")
	done
}

# The context and namespace a row's work runs in, given the direction
row_context()
{
	[ "${1}" == "extract" ] && echo -n "${MIG_SRC_CTX[${2}]}" || echo -n "${MIG_DST_CTX[${2}]}"
}

row_namespace()
{
	[ "${1}" == "extract" ] && echo -n "${MIG_SRC_NS[${2}]}" || echo -n "${MIG_DST_NS[${2}]}"
}

# How a row reads in messages
row_name()
{
	local I="${1}"
	local SRC="${MIG_SRC_CTX[${I}]}/${MIG_SRC_NS[${I}]}"
	local DST="${MIG_DST_CTX[${I}]}/${MIG_DST_NS[${I}]}"
	[ "${SRC}" == "${DST}" ] && echo -n "${SRC}" || echo -n "${SRC} -> ${DST}"
}
